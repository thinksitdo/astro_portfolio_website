---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';

import { isTodo } from '../lib/content';
import { DEFAULT_SHARE_IMAGE, SITE_NAME, isStaging, person } from '../lib/site';
import { noindexPaths } from '../lib/noindex.mjs';

interface Props {
  title: string;
  /** Search result and link preview text. "TODO" leaves it out and warns in the terminal */
  description?: string;
  /** No longer used: the redesign has one body face. Kept so existing pages still compile */
  bodyFont?: 'mono' | 'inter';
  /** Keep this page out of search results. Prefer adding the path to lib/noindex.mjs, which also drops it from the sitemap */
  noindex?: boolean;
  /** Link preview image: the page's thumbnail. Falls back to DEFAULT_SHARE_IMAGE */
  image?: { src: string; width?: number; height?: number } | null;
  /** Open Graph type: 'article' for case studies and publications */
  ogType?: 'website' | 'article';
}

const { title, description, noindex = false, image, ogType = 'website' } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const desc = isTodo(description) ? undefined : description!.trim();
if (!desc) console.warn(`[meta] ${Astro.url.pathname} has no description yet.`);
const robots = noindex || isStaging || noindexPaths.includes(Astro.url.pathname) ? 'noindex, nofollow' : undefined;
const share = image ?? (DEFAULT_SHARE_IMAGE ? { src: DEFAULT_SHARE_IMAGE } : null);
const shareUrl = share ? new URL(share.src, Astro.site).href : undefined;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {desc && <meta name="description" content={desc} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="dark light" />

    <!-- Link previews (LinkedIn, Slack, iMessage and others) -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {desc && <meta property="og:description" content={desc} />}
    {shareUrl && <meta property="og:image" content={shareUrl} />}
    {shareUrl && share?.width && <meta property="og:image:width" content={String(share.width)} />}
    {shareUrl && share?.height && <meta property="og:image:height" content={String(share.height)} />}
    <meta name="twitter:card" content={shareUrl ? 'summary_large_image' : 'summary'} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}

    <!-- Set the theme before first paint: the stored choice, else light. The js class turns on the
         marker's sweep-in, so without JavaScript the highlights simply show -->
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') theme = 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add('js');
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <Menu />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // The marker: highlighted phrases sweep in as they scroll into view. Section names and link labels are left out
      const marks = document.querySelectorAll('main .hl:not(.slink .hl):not(.no-sweep)');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) marks.forEach((m) => m.classList.add('sweep', 'on'));
      else {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          setTimeout(() => e.target.classList.add('on'), 150);
          io.unobserve(e.target);
        }), { rootMargin: '0px 0px -12% 0px' });
        marks.forEach((m) => { m.classList.add('sweep'); io.observe(m); });
      }
    </script>
  </body>
</html>
