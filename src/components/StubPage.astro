---
// A page that exists so links resolve, but has no design or copy yet.
import BackLink from './BackLink.astro';
interface Props {
  heading: string;
  note: string;
}
const { heading, note } = Astro.props;
---
<section class="g page-hero stub">
  <BackLink href="/">Back to home</BackLink>
  <h1 class="statement">{heading}</h1>
  <p class="copy intro"><span class="todo">TODO</span> {note}</p>
</section>
