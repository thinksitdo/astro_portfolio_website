---
// Sticky header: London clock, light and dark switch, Get in touch, menu button.
// The stepping figure (a link home) lives here too. On the homepage it starts large in the slot above
// the heading (.fig-slot) and, as the page scrolls, shrinks and moves up into the header's first column.
// On other pages it sits there from the start.
import ThemeSwitch from './ThemeSwitch.astro';
---
<header class="g top" id="top">
  <div class="r">
    <span class="clock label" aria-label="Time in London">London <span data-time>--:--</span></span>
    <ThemeSwitch />
    <a class="btn talk" href="/contact/">Get in touch<svg class="plane" viewBox="0 0 16 16" aria-hidden="true"><path d="M14.5 1.5 1.5 7l5 2.5 2.5 5 5.5-13zM6.5 9.5l8-8"></path></svg></a>
    <button class="burger menu-open" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu"><svg viewBox="0 0 20 10" aria-hidden="true"><path d="M1 1h18M1 9h12"></path></svg></button>
  </div>
</header>
<a class="fig" href="/" aria-label="Home"><i></i></a>

<style>
  .top { position: sticky; top: 0; z-index: 40; padding-top: clamp(14px, 1.6vw, 24px); padding-bottom: clamp(14px, 1.6vw, 24px); align-items: center; background: var(--bg); }
  .r { grid-column: 4 / -1; grid-row: 1; display: flex; justify-content: flex-end; align-items: center; gap: clamp(12px, 2vw, 32px); }
  .clock { white-space: nowrap; }
  .clock::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 6px; background: var(--ink); vertical-align: 1px; }

  /* The stepping figure: 12 frames in one strip, all registered on the planted foot, which sits on the
     bottom centre of the circle. The rest of the figure may step outside it */
  .fig { position: fixed; left: 0; top: 0; z-index: 45; width: var(--d-a); height: var(--d-a); transform-origin: 0 0; will-change: transform; visibility: hidden; }
  .fig:global(.ready) { visibility: visible; }
  .fig::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--fig-bg); }
  .fig i { position: absolute; height: 118%; aspect-ratio: 880 / 850; top: calc(97% - 118% * 804 / 850); left: calc(50% - 118% * 329 / 850); background: url('/media/stepping-12.webp') no-repeat; background-size: 1200% 100%; background-position: calc(var(--frame, 0) * 100% / 11) 0; filter: grayscale(1) contrast(1.15); pointer-events: none; }
  .fig:focus-visible { outline-offset: 6px; border-radius: 50%; }

  /* The clock gives way below 1000px; the switch moves into the menu on phones */
  @media (max-width: 1000px) { .clock { display: none; } }
  @media (max-width: 760px) {
    .r { grid-column: 2 / -1; gap: 10px; }
    .r :global(.tsw) { display: none; }
  }
</style>

<script>
  // Clock: the time in London
  const time = document.querySelector<HTMLElement>('[data-time]');
  const tick = () => { if (time) time.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' }).format(new Date()); };
  tick();
  setInterval(tick, 15000);

  // The stepping figure. Hover plays the steps on a loop and leaves it where it stopped;
  // scrolling steps on from there, one step every 60px. Still with reduced motion
  const fig = document.querySelector<HTMLElement>('.fig')!;
  const header = document.querySelector<HTMLElement>('header.top')!;
  const burger = header.querySelector<HTMLElement>('.menu-open')!;
  const N = 12;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let frame = 0;
  let timer = 0;
  let lastStep = Math.floor(scrollY / 60);
  const show = (f: number) => { frame = ((f % N) + N) % N; fig.style.setProperty('--frame', String(frame)); };
  show(0);
  if (!still) {
    fig.addEventListener('mouseenter', () => { clearInterval(timer); timer = window.setInterval(() => show(frame + 1), 110); });
    fig.addEventListener('mouseleave', () => { clearInterval(timer); timer = 0; });
  }

  // Two stages: large in the homepage slot, docked in the header's first column once scrolled
  const slot = document.querySelector<HTMLElement>('.fig-slot');
  const phone = matchMedia('(max-width: 760px)');
  const ease = (t: number) => t * t * (3 - 2 * t);
  const place = () => {
    const d = fig.offsetWidth;
    const hr = header.getBoundingClientRect();
    const b = burger.getBoundingClientRect();
    const dd = phone.matches ? 40 : 48;
    const dock = { x: hr.left + parseFloat(getComputedStyle(header).paddingLeft), y: b.top + (b.height - dd) / 2 };
    let x = dock.x, y = dock.y, size = dd;
    if (slot) {
      const r = slot.getBoundingClientRect();
      const t = ease(Math.min(1, Math.max(0, scrollY / 260)));
      x = r.left + (dock.x - r.left) * t;
      y = r.top + (dock.y - r.top) * t;
      size = d + (dd - d) * t;
    }
    fig.style.transform = `translate(${x}px, ${y}px) scale(${size / d})`;
    fig.classList.add('ready');
  };
  let ticking = false;
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      place();
      if (still || timer) return;
      const step = Math.floor(scrollY / 60);
      if (step !== lastStep) { show(frame + step - lastStep); lastStep = step; }
    });
  }, { passive: true });
  addEventListener('resize', place);
  document.fonts?.ready.then(place);
  place();
</script>
