---
import ThemeSwitch from './ThemeSwitch.astro';
import Logo from './Logo.astro';
---
<!-- Two headers. The large one is part of the page and scrolls away with it. Once it is off screen,
     a separate compact header (the original height, with its rule) slides down from the top, and
     slides away again when the large one comes back into view. While hidden it is inert. -->
<header class="site-header" id="top">
  <div class="wrap bar">
    <Logo />
    <div class="actions">
      <ThemeSwitch />
      <a class="b-pri pk talk" href="/contact/">Let’s talk →</a>
      <button class="icon-btn menu-open" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
        <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true" focusable="false"><path d="M0 2H22M0 8H22M0 14H22" stroke="currentColor" stroke-width="3"></path></svg>
      </button>
    </div>
  </div>
</header>

<div class="site-header-compact" aria-hidden="true" inert>
  <div class="wrap bar">
    <Logo />
    <div class="actions">
      <ThemeSwitch />
      <a class="b-pri pk talk" href="/contact/">Let’s talk →</a>
      <button class="icon-btn menu-open" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
        <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true" focusable="false"><path d="M0 2H22M0 8H22M0 14H22" stroke="currentColor" stroke-width="3"></path></svg>
      </button>
    </div>
  </div>
</div>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 32px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Large: the logo about twice the compact size, the controls level with its top, no rule */
  .site-header { background: var(--bg); }
  .site-header .bar { align-items: flex-start; padding-block: var(--step-16-32) 0; }
  .site-header :global(.h-logo) { min-height: 0; padding: 0; }
  .site-header :global(.h-logo img) { height: clamp(56px, 5.2vw, 72px); }

  /* Compact: the original header, fixed to the top, out of view until the large one has gone */
  .site-header-compact {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: var(--rule) solid var(--ink);
    transform: translateY(calc(-100% - 8px));
    visibility: hidden;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1), visibility 0s linear .5s;
  }
  .site-header-compact.is-shown {
    transform: none;
    visibility: visible;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1), visibility 0s;
  }
  .site-header-compact .bar { align-items: stretch; }
  .site-header-compact .actions { padding: 16px 0; }
  @media (prefers-reduced-motion: reduce) {
    .site-header-compact, .site-header-compact.is-shown { transition: none; }
  }

  /* On phones Let's talk moves into the menu, so the header stays on one row */
  @media (max-width: 480px) {
    .talk { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const compact = document.querySelector<HTMLElement>('.site-header-compact');
  if (header && compact) {
    // The large header's height, for the hero filling the rest of the first screen
    const publish = () => document.documentElement.style.setProperty('--header-tall', `${header.offsetHeight}px`);
    publish();
    new ResizeObserver(publish).observe(header);

    // Show the compact header once the large one is entirely off screen
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting && entry.boundingClientRect.bottom <= 0;
      compact.classList.toggle('is-shown', show);
      compact.inert = !show;
      compact.setAttribute('aria-hidden', String(!show));
    }).observe(header);
  }
</script>
