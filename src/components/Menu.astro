---
import ThemeSwitch from './ThemeSwitch.astro';

const items = [
  { label: 'Home', href: '/' },
  { label: 'Cases', href: '/cases/' },
  { label: 'Academic & Artistic', href: '/academic-artistic/' },
  { label: 'Publications', href: '/publications/' },
  { label: 'Thesis', href: '/thesis/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const current = Astro.url.pathname;
---
<dialog id="site-menu" class="menu" aria-label="Menu">
  <div class="g menu-top">
    <button class="burger close menu-close" type="button" aria-label="Close menu"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12"></path></svg></button>
  </div>

  <nav aria-label="Main" class="g menu-nav">
    <ol class="sub">
      {items.map((item, i) => (
        <li class="sub">
          <a class="sub" href={item.href} aria-current={item.href === current ? 'page' : undefined}>
            <span class="mi-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="mi-t statement"><span class="mk-hl">{item.label}</span></span>
            <span class="mi-a" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="g menu-foot">
    <div class="label">
      <a href="mailto:hello@scottrobinson.co.uk" style="text-transform: none">hello@scottrobinson.co.uk</a>
      <ThemeSwitch />
      <a href="https://www.linkedin.com/in/drscottrobinson/" rel="external">LinkedIn ↗</a>
    </div>
  </div>
</dialog>

<style>
  /* Full screen, exactly one viewport tall */
  .menu { position: fixed; inset: 0; width: 100%; max-width: none; height: 100vh; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: var(--bg); color: var(--ink); overflow-y: auto; }
  .menu[open] { display: flex; flex-direction: column; animation: menu-in .3s ease; }
  .menu::backdrop { background: var(--bg); }
  @keyframes menu-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .menu[open] { animation: none; } }
  .menu-top { padding-top: clamp(14px, 1.6vw, 24px); padding-bottom: clamp(14px, 1.6vw, 24px); }
  .menu-top .close { grid-column: -2 / -1; justify-self: end; }

  .menu-nav { flex: 1 1 auto; align-content: center; padding-top: 16px; padding-bottom: 16px; }
  ol { margin: 0; padding: 0; list-style: none; }
  li { border-top: 1px solid var(--ink); }
  li:last-child { border-bottom: 1px solid var(--ink); }
  a.sub { align-items: baseline; padding: clamp(8px, 1.3vh, 18px) 0; color: var(--ink); }
  a.sub:focus-visible { outline: none; }
  .mi-n { grid-column: 1 / 2; font: 600 12px var(--mono); letter-spacing: .04em; color: var(--grey); }
  .mi-t { grid-column: 2 / 11; font-size: clamp(30px, min(4.8vw, 7vh), 76px); line-height: 1.08; }
  /* The marker sweeps in behind the item under the cursor, and marks the current page */
  .mk-hl { padding: .09em .08em .05em; margin: 0 -.08em; box-decoration-break: clone; -webkit-box-decoration-break: clone; background: linear-gradient(var(--hl-bg), var(--hl-bg)) no-repeat 0 0 / 0% 100%; transition: background-size .45s var(--e), color .2s ease; }
  a:hover .mk-hl, a:focus-visible .mk-hl, a[aria-current] .mk-hl { background-size: 100% 100%; color: var(--hl-ink); }
  .mi-a { grid-column: 12 / 13; justify-self: end; font: 500 20px var(--mono); color: var(--hl-ink); opacity: 0; transform: translateX(-14px); transition: opacity .2s ease, transform .35s cubic-bezier(.3, 1.5, .5, 1); }
  a:hover .mi-a, a:focus-visible .mi-a { opacity: 1; transform: none; }

  .menu-foot > div { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0 28px; }
  .menu-foot a:hover { color: var(--hl-ink); }

  @media (max-width: 760px) {
    .mi-n, .mi-a { display: none; }
    .mi-t { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) { .mk-hl, .mi-a { transition: none; } }

  :global(html:has(#site-menu[open])) { overflow: hidden; }
</style>

<script>
  const dialog = document.getElementById('site-menu') as HTMLDialogElement | null;
  // Both headers (the large one and the compact one that slides in) have a menu button
  const openBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.menu-open'));
  const closeBtn = dialog?.querySelector<HTMLButtonElement>('.menu-close');
  let openBtn: HTMLButtonElement | undefined;

  if (dialog && openBtns.length) {
    const focusables = () =>
      Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    openBtns.forEach((btn) => btn.addEventListener('click', () => {
      openBtn = btn;
      dialog.showModal();
      btn.setAttribute('aria-expanded', 'true');
      closeBtn?.focus();
    }));

    // Escape triggers 'close' natively; return focus to the menu button that opened it
    dialog.addEventListener('close', () => {
      openBtn?.setAttribute('aria-expanded', 'false');
      openBtn?.focus();
    });

    closeBtn?.addEventListener('click', () => dialog.close());

    // Keep Tab inside the menu
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Close before following a link, so in-page links (/#research) land with the menu shut
    dialog.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', () => dialog.close());
    });
  }
</script>
