---
import Logo from './Logo.astro';

const items = [
  { label: 'Home', href: '/' },
  { label: 'Cases', href: '/cases/' },
  { label: 'Academic & Artistic', href: '/academic-artistic/' },
  { label: 'Publications', href: '/publications/' },
  { label: 'Thesis', href: '/thesis/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const current = Astro.url.pathname;
---
<dialog id="site-menu" class="sr-menu-wrap" aria-label="Menu">
  <div class="menu-top">
    <div class="wrap row">
      <Logo />
      <div class="top-actions">
      <a class="b-pri talk" href="/contact/">Let’s talk →</a>
      <button class="icon-btn menu-close" type="button" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M2 2L18 18M18 2L2 18" stroke="currentColor" stroke-width="3"></path></svg>
      </button>
      </div>
    </div>
  </div>

  <nav aria-label="Main" class="wrap menu-nav">
    <ol>
      {items.map((item) => (
        <li>
          <a class="sr-menu" href={item.href} aria-current={item.href === current ? 'page' : undefined}>
            <span class="sr-menu-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="menu-foot">
    <div class="wrap row label">
      <a class="l-mark" href="mailto:hello@scottrobinson.co.uk" style="text-transform: none">hello@scottrobinson.co.uk</a>
      <a class="l-mark" href="https://www.linkedin.com/in/drscottrobinson/">LinkedIn ↗</a>
    </div>
  </div>
</dialog>

<style>
  /* Exactly one viewport tall and never scrolls */
  .sr-menu-wrap {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
  }
  .sr-menu-wrap[open] { display: flex; flex-direction: column; }
  .sr-menu-wrap::backdrop { background: var(--bg); }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .menu-top { border-bottom: var(--rule) solid var(--ink); }
  .top-actions { display: flex; align-items: center; gap: 16px; }

  /* Let's talk only appears here on phones, where the header leaves it out */
  .talk { display: none; }
  @media (max-width: 480px) {
    .talk { display: inline-flex; }
  }
  .menu-foot { border-top: var(--rule) solid var(--ink); }
  .menu-foot .row { padding-top: 16px; padding-bottom: 32px; }

  .menu-nav {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-block: var(--step-16-32);
  }
  ol {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Rules only between items. The first item's top rule and the last item's bottom rule are there
     but transparent, so they appear on hover or focus without the layout moving */
  li {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    border-top: var(--rule) solid var(--ink);
  }
  li:first-child { border-top-color: transparent; }
  li:last-child { border-bottom: var(--rule) solid transparent; }
  li:first-child:hover, li:first-child:focus-within { border-top-color: var(--ink); }
  li:last-child:hover, li:last-child:focus-within { border-bottom-color: var(--ink); }

  .sr-menu {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 0 8px;
    color: var(--ink);
    text-decoration: none;
    transition: background-color .12s ease;
  }
  .sr-menu:hover,
  .sr-menu:focus-visible { background: var(--accent); color: var(--on-accent); }
  .sr-menu:focus-visible { outline-offset: -6px; }

  .sr-menu-label {
    font-family: var(--font-display);
    font-weight: 400;
    --lh: 1.05;
    letter-spacing: -0.01em;
    white-space: nowrap;
    font-size: clamp(20px, min(6.2vw, calc((100vh - 200px) / 7 * 0.62)), 112px);
    /* Castoro's line box has more room above the capitals than below the baseline, so centring the
       line box sat the words low. Trimmed to cap height and baseline, the capitals centre in the row */
    text-box: trim-both cap alphabetic;
  }
  @supports (height: 100dvh) {
    .sr-menu-label { font-size: clamp(20px, min(6.2vw, calc((100dvh - 200px) / 7 * 0.62)), 112px); }
  }

  :global(html:has(#site-menu[open])) { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .sr-menu { transition: none; }
  }
</style>

<script>
  const dialog = document.getElementById('site-menu') as HTMLDialogElement | null;
  // Both headers (the large one and the compact one that slides in) have a menu button
  const openBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.menu-open'));
  const closeBtn = dialog?.querySelector<HTMLButtonElement>('.menu-close');
  let openBtn: HTMLButtonElement | undefined;

  if (dialog && openBtns.length) {
    const focusables = () =>
      Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    openBtns.forEach((btn) => btn.addEventListener('click', () => {
      openBtn = btn;
      dialog.showModal();
      btn.setAttribute('aria-expanded', 'true');
      closeBtn?.focus();
    }));

    // Escape triggers 'close' natively; return focus to the menu button that opened it
    dialog.addEventListener('close', () => {
      openBtn?.setAttribute('aria-expanded', 'false');
      openBtn?.focus();
    });

    closeBtn?.addEventListener('click', () => dialog.close());

    // Keep Tab inside the menu
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Close before following a link, so in-page links (/#research) land with the menu shut
    dialog.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', () => dialog.close());
    });
  }
</script>
