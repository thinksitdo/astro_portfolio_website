---
// Case study template (design/reference/case-study.dc.html).
//   full:      hero, hero image, article, next case
//   lite:      hero, hero image, next case
//   protected: hero, hero image, password box, article once unlocked, next case
//              (the article is encrypted at build time, see lib/case-crypto.ts)
// The article is passed in the default slot. The academic and artistic pages reuse this with type "full".
import PasswordGate from './PasswordGate.astro';
import ContactBlock from './ContactBlock.astro';
import Lightbox from './Lightbox.astro';
import BackLink from './BackLink.astro';
import { isTodo } from '../lib/content';
import { encryptArticle } from '../lib/case-crypto';
import type { ResolvedImage } from '../lib/images';

interface MetaRow { label: string; value?: string; chips?: string[]; /** Pre-escaped HTML (see lib/inline-markdown) */ html?: string }
interface Props {
  type: 'full' | 'lite' | 'protected';
  title: string;
  intro: string;
  meta: MetaRow[];
  heroImage?: ResolvedImage | null;
  heroAlt?: string;
  next?: { label: string; title: string; href: string };
  back?: { label: string; href: string };
  /** Leave out the pink image band when there is no image, instead of showing a placeholder */
  imageOptional?: boolean;
}

const { type, title, intro, meta, heroImage, heroAlt, next, back = { label: '← Back to home', href: '/' }, imageOptional = false } = Astro.props;
const backLabel = back.label.replace(/^\s*←\s*/, '');
const showImageBand = !(imageOptional && !heroImage);
const showArticle = type !== 'lite';
// Protected articles are rendered to HTML here and only the encrypted form goes into the page
const payload = type === 'protected' ? encryptArticle(await Astro.slots.render('default')) : null;
---
<section class="g page-hero cs-hero">
  <BackLink href={back.href}>{backLabel}</BackLink>
  <h1 class="statement">{title}</h1>
  <p class="cs-intro">{isTodo(intro) ? <span class="todo">TODO</span> : intro}</p>
  <dl class="cs-meta">
    {meta.map((row) => (
      <div>
        <dt class="label">{row.label}</dt>
        <dd>
          {row.html
            ? <Fragment set:html={row.html} />
            : row.chips
            ? <span class="tags">{row.chips.map((c) => <span class="tag">{c}</span>)}</span>
            : isTodo(row.value) ? <span class="todo">TODO</span> : row.value}
        </dd>
      </div>
    ))}
  </dl>
</section>

{showImageBand && <section class="g cs-image" aria-label="Project image">
  <figure>
    {heroImage && 'src' in heroImage
      ? <img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={heroAlt && !isTodo(heroAlt) ? heroAlt : ''} />
      : heroImage && 'missing' in heroImage
        ? <div class="ph" role="img" aria-label={`Image not found, ${heroImage.missing}`}>Image not found · {heroImage.missing}</div>
        : <div class="ph" role="img" aria-label={`Image placeholder, ${title}`}>Image · {title}</div>}
  </figure>
</section>}

{type === 'protected' && <PasswordGate />}

{showArticle && (
  <section class="g cs-article" id="case-article" hidden={type === 'protected'} data-protected={type === 'protected' ? '' : undefined}>
    <div class="article-wrap">
      {type === 'protected' ? null : <slot />}
    </div>
  </section>
)}

{showArticle && <Lightbox />}

{type === 'protected' && payload && <script type="application/octet-stream" id="case-payload" set:text={payload} />}

{type === 'protected' && (
  <script is:inline>
    // Before first paint: a visitor who has unlocked before skips the password box while the article decrypts.
    // PasswordGate shows the box again if the stored key no longer works.
    try {
      var stored = JSON.parse(localStorage.getItem('sr_case_key') || 'null');
      if (stored && stored.exp > Date.now()) document.getElementById('case-gate')?.setAttribute('hidden', '');
    } catch (e) {}
  </script>
)}

{next && (
  <section class="g cs-next">
    <a class="next-row" href={next.href}>
      <span class="label next-label">{isTodo(next.label) ? <span class="todo">TODO</span> : next.label}</span>
      <span class="statement next-title"><span>{next.title}</span></span>
      <span class="next-arrow" aria-hidden="true">→</span>
    </a>
  </section>
)}

<ContactBlock />

<style>
  /* Top: back link, title, intro beside the details */
  .cs-hero h1 { grid-column: 1 / 11; font-size: clamp(36px, 4.6vw, 88px); }
  .cs-intro { grid-column: 1 / 7; margin-top: clamp(24px, 2.4vw, 40px); font-size: clamp(18px, 1.4vw, 23px); line-height: 1.45; letter-spacing: -.015em; font-weight: 400; }
  .cs-meta { grid-column: 8 / -1; margin: clamp(24px, 2.4vw, 40px) 0 0; align-self: start; }
  .cs-meta div { padding: 12px 0; border-top: 1px solid var(--ink); }
  .cs-meta div:last-child { border-bottom: 1px solid var(--ink); }
  .cs-meta dt { color: var(--grey); }
  .cs-meta dd { margin: 6px 0 0; font-size: clamp(15px, 1.1vw, 18px); line-height: 1.4; letter-spacing: -.012em; }
  .cs-meta dd :global(a) { border-bottom: 1px solid currentColor; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { padding: 4px 8px; border: var(--rw) solid var(--ink); font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .04em; }

  /* The project image */
  section.g.cs-image { padding-bottom: clamp(48px, 5vw, 96px); }
  .cs-image figure { grid-column: 1 / -1; margin: 0; border: var(--rw) solid var(--ink); background: var(--hl-bg); }
  .cs-image img { width: 100%; height: auto; }
  .ph { display: grid; place-items: center; aspect-ratio: 16 / 7; padding: 16px; text-align: center; font: 600 12px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--hl-ink); }

  /* Article: one text column, each section's title above its text, the number hanging in the margin.
     Figures run full width between sections. Sections and figures come from lib/markdown-plugins.mjs */
  .cs-article[hidden] { display: none; }
  section.g.cs-article { padding-bottom: 0; }
  .article-wrap { grid-column: 1 / -1; }
  .article-wrap :global(.cs-sec) { padding: clamp(28px, 2.6vw, 44px) 0 clamp(36px, 3.4vw, 60px); border-top: 3px solid var(--ink); }
  .article-wrap :global(.cs-sec-h), .article-wrap :global(.cs-sec-b) { max-width: 720px; margin-inline: auto; }
  .article-wrap :global(.cs-sec-h) { display: flex; gap: 16px; align-items: baseline; margin-bottom: 24px; }
  .article-wrap :global(.cs-sec-h:empty) { display: none; }
  .article-wrap :global(.cs-n) { font: 600 12px var(--mono); letter-spacing: .04em; color: var(--grey); }
  @media (min-width: 900px) { .article-wrap :global(.cs-n) { flex: 0 0 32px; margin-left: -48px; text-align: right; } }
  .article-wrap :global(h2) { margin: 0; font-family: var(--serif); font-weight: 400; font-variation-settings: 'opsz' 72; font-size: clamp(28px, 2.6vw, 42px); line-height: 1.1; letter-spacing: -.025em; color: var(--ink); }
  .article-wrap :global(.cs-sec-b) { min-width: 0; font-size: clamp(16px, 1.15vw, 19px); line-height: 1.6; letter-spacing: -.012em; color: var(--body); font-weight: 400; }
  .article-wrap :global(.cs-sec-b > *) { margin: 0 0 1em; }
  .article-wrap :global(.cs-sec-b > :last-child) { margin-bottom: 0; }
  .article-wrap :global(h3) { margin: 1.6em 0 .5em; font-family: var(--serif); font-weight: 400; font-size: clamp(21px, 1.7vw, 27px); line-height: 1.2; color: var(--ink); letter-spacing: -.02em; }
  .article-wrap :global(ul), .article-wrap :global(ol) { padding-left: 1.1em; }
  .article-wrap :global(li + li) { margin-top: .4em; }
  .article-wrap :global(strong) { color: var(--ink); font-weight: 600; }
  .article-wrap :global(.cs-sec-b a) { color: var(--ink); font-weight: 500; border-bottom: 1px solid currentColor; }
  .article-wrap :global(.cs-sec-b a:hover) { background: var(--hl-bg); color: var(--hl-ink); border-color: transparent; }
  .article-wrap :global(blockquote) { margin: 1.4em 0; padding-left: 20px; border-left: 3px solid var(--hl-bg); font-family: var(--serif); font-size: 1.2em; color: var(--ink); }

  /* Figures: one full width, or two side by side. Each image is a button that opens the lightbox */
  .article-wrap :global(.cs-figs) { padding-bottom: clamp(28px, 2.6vw, 44px); }
  .article-wrap :global(.cs-figs--two) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  @media (max-width: 720px) { .article-wrap :global(.cs-figs--two) { grid-template-columns: minmax(0, 1fr); } }
  .article-wrap :global(.cs-fig) { margin: 0; }
  .article-wrap :global(.cs-fig img) { width: 100%; height: auto; }
  .article-wrap :global(.cs-cap) { margin: 10px 0 0; font: 400 12px/1.4 var(--mono); letter-spacing: .02em; color: var(--grey); }
  .article-wrap :global(.cs-cap-n) { font-weight: 600; color: var(--ink); }

  /* Next: one big row, the marker sweeps behind the title */
  section.g.cs-next { padding-bottom: 0; }
  .next-row { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: baseline; padding: clamp(20px, 2vw, 32px) 0; border-top: 3px solid var(--ink); border-bottom: var(--rw) solid var(--ink); color: var(--ink); }
  .next-label { grid-column: 1 / 3; color: var(--grey); }
  .next-title { grid-column: 3 / 12; font-size: clamp(26px, 2.6vw, 44px); line-height: 1.1; letter-spacing: -.025em; }
  .next-title span { padding: .06em .08em .03em; margin: 0 -.08em; box-decoration-break: clone; -webkit-box-decoration-break: clone; background: linear-gradient(var(--hl-bg), var(--hl-bg)) no-repeat 0 0 / 0% 100%; transition: background-size .45s var(--e), color .2s; }
  .next-row:hover .next-title span, .next-row:focus-visible .next-title span { background-size: 100% 100%; color: var(--hl-ink); }
  .next-arrow { grid-column: 12 / 13; justify-self: end; font: 600 22px var(--mono); transition: transform .25s; }
  .next-row:hover .next-arrow { transform: translateX(4px); }
  :global(.cs-next + .contact-block) { padding-top: clamp(64px, 7vw, 128px); }

  @media (max-width: 760px) {
    .cs-hero h1, .cs-intro, .cs-meta { grid-column: 1 / -1; }
    .next-label { grid-column: 1 / -1; } .next-title { grid-column: 1 / 4; } .next-arrow { grid-column: 4 / 5; }
  }
</style>
