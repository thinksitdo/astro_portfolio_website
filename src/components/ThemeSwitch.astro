---
// Light and dark switch: two segments, ink edged, the active one filled ink and the other taking the
// marker on hover. The theme itself is set before first paint by the inline script in BaseLayout;
// aria-checked is corrected on load by the script below. There is one in the header and one in the
// menu (for phones), and they stay in step.
---
<button class="tsw" type="button" role="switch" aria-checked="false" aria-label="Dark mode">
  <span class="t-l">Light<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></svg></span>
  <span class="t-d">Dark<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path></svg></span>
</button>

<style>
  .tsw { display: inline-flex; height: 44px; padding: 0; border: var(--rw) solid var(--ink); background: var(--bg); color: var(--ink); font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .06em; }
  .tsw span { display: flex; align-items: center; gap: 8px; padding: 0 14px; transition: background-color .15s, color .15s; }
  .t-l { border-right: var(--rw) solid var(--ink); }
  .tsw[aria-checked='false'] .t-l, .tsw[aria-checked='true'] .t-d { background: var(--ink); color: var(--bg); }
  .tsw[aria-checked='false'] .t-d:hover, .tsw[aria-checked='true'] .t-l:hover { background: var(--hl-bg); color: var(--hl-ink); }
  svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; }
</style>

<script>
  const STORAGE_KEY = 'theme';
  const root = document.documentElement;
  const switches = () => document.querySelectorAll<HTMLButtonElement>('.tsw');

  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    switches().forEach((btn) => btn.setAttribute('aria-checked', theme === 'dark' ? 'true' : 'false'));
  }

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');

  switches().forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(next);
      try { localStorage.setItem(STORAGE_KEY, next); } catch { /* storage unavailable */ }
    });
  });
</script>
