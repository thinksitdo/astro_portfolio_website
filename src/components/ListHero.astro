---
// Top of the Cases, Publications and Academic & Artistic pages: back link, title, intro (slot)
import BackLink from './BackLink.astro';
interface Props {
  title: string;
  /** Kept for older call sites; the redesign has one title size */
  size?: 'xl' | 'lg';
}
const { title } = Astro.props;
---
<section class="g page-hero">
  <BackLink href="/">Back to home</BackLink>
  <h1 class="statement">{title}</h1>
  <p class="copy intro"><slot /></p>
</section>
