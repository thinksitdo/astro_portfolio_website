---
// Password box for protected case studies. The article is encrypted at build time (lib/case-crypto.ts);
// the password the visitor types makes the key that decrypts it, in the browser. A wrong password
// simply fails to decrypt. Once unlocked, the key is kept for 30 days so other protected cases open
// without asking again.
import { CASE_ITERATIONS, CASE_SALT } from '../lib/case-crypto';
---
<section class="g gate" id="case-gate" data-salt={CASE_SALT} data-iterations={CASE_ITERATIONS}>
  <div class="gate-box">
    <div class="gate-head">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
      <h2 class="statement">The full case study</h2>
    </div>
    <p class="copy gate-text">A deeper look at this project, covering the process, the artefacts and what changed as a result, is available to recruiters and hiring managers. Enter the password from my CV to read on.</p>
    <form class="gate-form" novalidate>
      <label class="label" for="case-pw">Password</label>
      <div class="gate-fields">
        <input id="case-pw" name="password" type="password" autocomplete="current-password" aria-invalid="false" aria-describedby="case-pw-msg" required />
        <button class="btn unlock" type="submit">Unlock<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></button>
      </div>
      <p id="case-pw-msg" class="gate-error" role="alert" hidden>
        <span aria-hidden="true" class="bang">!</span><span>That password didn’t work. Check the case study details in my CV, or ask me for it.</span>
      </p>
    </form>
    <p class="gate-ask">Don’t have it? <a href="/contact/">Ask for the password</a></p>
  </div>
</section>

<style>
  .gate[hidden] { display: none; }
  section.g.gate { padding-bottom: clamp(64px, 7vw, 128px); }
  /* The box: ink edged with a hard shadow, room left for the shadow on phones */
  .gate-box { grid-column: 1 / 8; margin-right: 8px; padding: clamp(20px, 2.4vw, 40px); border: var(--rw) solid var(--ink); box-shadow: 8px 8px 0 var(--ink); background: var(--bg); }
  .gate-head { display: flex; align-items: center; gap: 16px; }
  .gate-head svg { flex: none; width: 34px; height: 34px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; }
  .gate-head h2 { margin: 0; font-size: clamp(28px, 2.6vw, 40px); }
  .gate-text { margin-top: 14px; }
  .gate-form { margin-top: 28px; }
  label { display: block; margin-bottom: 8px; }
  .gate-fields { display: flex; flex-wrap: wrap; gap: 14px; }
  input { flex: 1 1 240px; min-width: 0; height: 52px; padding: 0 16px; border: var(--rw) solid var(--ink); border-radius: 0; background: var(--bg); color: var(--ink); font: 500 18px var(--mono); }
  input:focus-visible { outline: 3px solid var(--hl-bg); outline-offset: 0; }
  input[aria-invalid='true'] { border-color: var(--hl-ink); }
  .unlock { height: 52px; }
  .unlock[aria-busy='true'] { opacity: .6; cursor: progress; }
  .gate-error { display: flex; gap: 10px; margin: 16px 0 0; padding: 14px 16px; border: var(--rw) solid var(--ink); background: var(--hl-bg); color: var(--hl-ink); font-size: 15px; line-height: 1.45; }
  .gate-error[hidden] { display: none; }
  .bang { font: 700 15px var(--mono); }
  .gate-ask { margin-top: 28px; padding-top: 14px; border-top: var(--rw) solid var(--ink); font-size: 15px; }
  .gate-ask a { font-weight: 600; border-bottom: 1px solid currentColor; }
  .gate-ask a:hover { background: var(--hl-bg); color: var(--hl-ink); border-color: transparent; }
  @media (max-width: 760px) { .gate-box { grid-column: 1 / -1; } }
</style>

<script>
  const KEY_STORE = 'sr_case_key';
  const KEEP_FOR = 30 * 24 * 60 * 60 * 1000;

  const gate = document.getElementById('case-gate');
  const article = document.getElementById('case-article');
  const target = article?.querySelector<HTMLElement>('.article-wrap');
  const payload = document.getElementById('case-payload')?.textContent?.trim() ?? '';
  const form = gate?.querySelector('form');
  const input = gate?.querySelector<HTMLInputElement>('#case-pw');
  const button = gate?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const msg = gate?.querySelector<HTMLElement>('#case-pw-msg');

  const toHex = (bytes: Uint8Array) => Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
  const fromHex = (hex: string) => new Uint8Array((hex.match(/../g) ?? []).map((h) => parseInt(h, 16)));

  /** The same key the build made: PBKDF2-SHA256 of the password (see lib/case-crypto.ts) */
  async function deriveKey(password: string) {
    const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveBits']);
    const bits = await crypto.subtle.deriveBits(
      { name: 'PBKDF2', hash: 'SHA-256', salt: new TextEncoder().encode(gate?.dataset.salt ?? ''), iterations: Number(gate?.dataset.iterations) },
      base,
      256,
    );
    return new Uint8Array(bits);
  }

  /** Throws when the key is wrong (AES-GCM checks the data has not been tampered with) */
  async function decrypt(rawKey: Uint8Array) {
    if (!payload) throw new Error('No article');
    const data = Uint8Array.from(atob(payload), (c) => c.charCodeAt(0));
    const key = await crypto.subtle.importKey('raw', rawKey, 'AES-GCM', false, ['decrypt']);
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: data.slice(0, 12) }, key, data.slice(12));
    return new TextDecoder().decode(plain);
  }

  function reveal(html: string, moveFocus: boolean) {
    if (target) target.innerHTML = html;
    gate?.setAttribute('hidden', '');
    article?.removeAttribute('hidden');
    if (moveFocus && article) {
      // Move focus to the start of the article so keyboard and screen reader users land on it
      const first = article.querySelector<HTMLElement>('h2') ?? article;
      first.setAttribute('tabindex', '-1');
      first.focus();
    }
  }

  function fail() {
    input?.setAttribute('aria-invalid', 'true');
    msg?.removeAttribute('hidden');
    input?.focus();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const value = input?.value ?? '';
    if (!value) return fail();
    if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); }
    try {
      const rawKey = await deriveKey(value);
      const html = await decrypt(rawKey);
      try { localStorage.setItem(KEY_STORE, JSON.stringify({ k: toHex(rawKey), exp: Date.now() + KEEP_FOR })); } catch {}
      reveal(html, true);
    } catch {
      fail();
    } finally {
      if (button) { button.disabled = false; button.removeAttribute('aria-busy'); }
    }
  });

  input?.addEventListener('input', () => {
    input.setAttribute('aria-invalid', 'false');
    msg?.setAttribute('hidden', '');
  });

  // Unlocked before: decrypt with the stored key. If that fails (expired, or the password changed), ask again.
  (async () => {
    let stored: { k?: string; exp?: number } | null = null;
    try { stored = JSON.parse(localStorage.getItem(KEY_STORE) ?? 'null'); } catch {}
    if (!stored?.k || !stored.exp || stored.exp < Date.now()) return;
    try {
      reveal(await decrypt(fromHex(stored.k)), false);
    } catch {
      try { localStorage.removeItem(KEY_STORE); } catch {}
      gate?.removeAttribute('hidden');
    }
  })();
</script>
