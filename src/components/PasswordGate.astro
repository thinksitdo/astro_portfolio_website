---
// Client-side password box for protected case studies. NOT secure: the article is in the page,
// only hidden. Scott has agreed to this for now. The entered password is hashed with SHA-256 and
// compared with PUBLIC_CASE_PASSWORD_SHA256, set at build time, so the plain password is not in the source.
const expectedHash = (import.meta.env.PUBLIC_CASE_PASSWORD_SHA256 ?? '').trim().toLowerCase();
if (!expectedHash) {
  console.warn('[case gate] PUBLIC_CASE_PASSWORD_SHA256 is not set, so no password will unlock protected case studies.');
}
---
<section class="gate" id="case-gate" data-hash={expectedHash}>
  <div class="wrap gate-wrap">
    <div class="gate-box">
      <div class="gate-head">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><rect x="4" y="11" width="16" height="10"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        <h2>The full case study</h2>
      </div>
      <p class="gate-text">A deeper look at this project, covering the process, the artefacts and what changed as a result, is available to recruiters and hiring managers. Enter the password from my CV to read on.</p>
      <form class="gate-form" novalidate>
        <label for="case-pw">Password</label>
        <div class="gate-fields">
          <input id="case-pw" name="password" type="password" autocomplete="current-password" aria-invalid="false" aria-describedby="case-pw-msg" required />
          <button class="b-pri unlock" type="submit">Unlock →</button>
        </div>
        <p id="case-pw-msg" class="gate-error" role="alert" hidden>
          <span aria-hidden="true" class="bang">!</span><span>That password didn’t work. Check the case study details in my CV, or ask me for it.</span>
        </p>
      </form>
      <p class="gate-ask">Don’t have it? <a class="l-mark" href="mailto:hello@scottrobinson.co.uk?subject=Case%20study%20password">Ask for the password</a></p>
    </div>
  </div>
</section>

<style>
  .gate { border-bottom: var(--rule) solid var(--ink); }
  .gate[hidden] { display: none; }
  .gate-wrap { padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(48px, 7vw, 96px); }
  .gate-box {
    max-width: 720px;
    border: var(--rule) solid var(--ink);
    box-shadow: 10px 10px 0 var(--ink);
    background: var(--bg);
    padding: clamp(24px, 3vw, 40px);
  }
  .gate-head { display: flex; align-items: center; gap: 16px; }
  .gate-head svg { flex: none; }
  .gate-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 32px;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .gate-text { margin: 16px 0 0; color: var(--muted); }
  .gate-form { margin: 28px 0 0; }
  label {
    display: block;
    margin-bottom: 8px;
    font: 600 12px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .gate-fields { display: flex; flex-wrap: wrap; gap: 12px; }
  input {
    flex: 1 1 240px;
    min-width: 0;
    min-height: 56px;
    padding: 0 16px;
    border: var(--rule) solid var(--ink);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
    font: 500 18px var(--font-mono);
  }
  input[aria-invalid='true'] { border-color: var(--accent); }
  /* No focus state was designed for the input: use the standard focus outline */
  input:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .unlock { min-height: 56px; padding: 0 24px; border-width: 3px; font-size: 14px; }
  .gate-error {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 14px 0 0;
    padding: 12px 14px;
    border: var(--rule) solid var(--ink);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 15px;
    line-height: 1.45;
  }
  .gate-error[hidden] { display: none; }
  .bang { font: 700 16px var(--font-mono); }
  .gate-ask { margin: 24px 0 0; padding-top: 18px; border-top: var(--rule-thin) solid var(--ink); font-size: 15px; }
  .gate-ask a { color: var(--ink); font-weight: 600; }
</style>

<script>
  const gate = document.getElementById('case-gate');
  const article = document.getElementById('case-article');
  const form = gate?.querySelector('form');
  const input = gate?.querySelector<HTMLInputElement>('#case-pw');
  const msg = gate?.querySelector<HTMLElement>('#case-pw-msg');

  async function sha256(text: string) {
    const bytes = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return Array.from(new Uint8Array(bytes), (b) => b.toString(16).padStart(2, '0')).join('');
  }

  function unlock() {
    document.cookie = 'sr_cases=1; path=/; max-age=2592000; SameSite=Lax';
    gate?.setAttribute('hidden', '');
    if (article) {
      article.removeAttribute('hidden');
      // Move focus to the start of the article so keyboard and screen reader users land on it
      const first = article.querySelector<HTMLElement>('h2') ?? article;
      first.setAttribute('tabindex', '-1');
      first.focus();
    }
  }

  function fail() {
    input?.setAttribute('aria-invalid', 'true');
    msg?.removeAttribute('hidden');
    input?.focus();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const expected = gate?.dataset.hash ?? '';
    const value = input?.value ?? '';
    if (expected && value && (await sha256(value)) === expected) unlock();
    else fail();
  });

  input?.addEventListener('input', () => {
    input.setAttribute('aria-invalid', 'false');
    msg?.setAttribute('hidden', '');
  });
</script>
