---
// Email and buttons at the foot of inner pages (case studies, lists, thesis)
---
<section id="contact" class="cs-contact" aria-label="Get in touch">
  <div class="wrap">
    <a class="l-mark big-mail" href="mailto:hello@scottrobinson.co.uk">hello@scottrobinson.co.uk</a>
    <div class="contact-actions">
      <a class="b-pri pk lg" href="mailto:hello@scottrobinson.co.uk">Get in touch →</a>
      <a class="b-sec lg" href="https://www.linkedin.com/in/drscottrobinson/">LinkedIn ↗</a>
    </div>
  </div>
</section>

<style>
  .cs-contact { border-bottom: var(--rule) solid var(--ink); }
  .cs-contact .wrap { padding-block: var(--step-32-64); }
  .big-mail {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 5vw, 80px);
    --lh: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration-thickness: 3px;
    text-underline-offset: 10px;
    overflow-wrap: anywhere;
  }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 32px; }
  .contact-actions .lg { min-height: 48px; font-size: 13px; }
</style>
