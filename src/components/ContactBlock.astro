---
// Get in touch, at the foot of every page: the section's name, then the contact form and LinkedIn
---
<section class="g contact-block" id="contact" aria-label="Get in touch">
  <h2 class="head statement">Get in touch</h2>
  <nav class="c-links" aria-label="Get in touch">
    <a class="slink" href="/contact/"><span class="hl">Contact form</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
    <a class="slink" href="https://www.linkedin.com/in/drscottrobinson/" rel="external"><span class="hl">LinkedIn</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7"></path></svg></a>
  </nav>
</section>

<style>
  .c-links { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 16px clamp(28px, 3vw, 56px); margin-top: clamp(28px, 2.6vw, 44px); }
</style>
