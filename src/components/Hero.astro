---
import { caseUrl, getCases } from '../lib/content';
import { resolveImageSrc, PORTRAIT_WIDTH, THUMB_WIDTH } from '../lib/images';

interface Props {
  /** grid: headline and video over a row of Get in touch, the case slideshow and See my work.
      split: headline on the left with the name box and both tiles joined beneath it, and the video
      the full height on the right, as the first slide of a slideshow of case portrait images.
      open: as split, but inside the page wrapper with no ruled cells. The tiles stand apart, and the
      right-hand column is the zoetrope alone (no video), large and running off the right edge. */
  layout?: 'grid' | 'split' | 'open';
}
const { layout = 'grid' } = Astro.props;
const open = layout === 'open';
const split = layout === 'split' || open;
const cases = await getCases();

// Grid: the slideshow shows the first five case studies' thumbnails
const slides = cases.slice(0, 5).map((c) => ({
  title: c.data.title,
  href: caseUrl(c),
  thumbnail: resolveImageSrc(c.filePath, c.data.thumbnail, THUMB_WIDTH),
}));
// Split: the video, then every case that has a portrait image (heroPortrait), in case order.
// A case without one is left out, so with none the video shows alone and there are no arrows
const portraits = split
  ? cases.flatMap((c) => {
      const src = resolveImageSrc(c.filePath, c.data.heroPortrait, PORTRAIT_WIDTH);
      return src ? [{ title: c.data.title, href: caseUrl(c), src }] : [];
    })
  : [];
const stageTotal = portraits.length + 1;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class:list={['hx-hero', { 'hx-split': split, 'hx-open': open }]} data-layout={layout} aria-label="Introduction">
  <div class="hx-strap">
    <h1 class="hx-h1">I research encounters between people and technology, and use what I learn to design better products.</h1>
    <div class:list={['hx-bottom', { 'hx-card': split }]}>
    <div class="hx-name">
      <span class="l1">Dr Scott Robinson</span>
      <span class="l2">London, UK • Hybrid or Remote • Permanent or Contract</span>
      <span class="l3">User Research <span aria-hidden="true">⇄</span><span class="visually-hidden">, moving back and forth with </span> UX and Product Design <span aria-hidden="true">⇄</span><span class="visually-hidden">, moving back and forth with </span> Product Strategy</span>
    </div>
    {split && <>
      <a class="hx-tile hx-cta b-tileP" href="/contact/"><span class="t">Get in touch</span></a>
      <a class="hx-tile hx-work b-tileS" href="#work"><span class="t">See my work</span></a>
    </>}
    </div>
  </div>

  <div
    class="hx-video scrub"
    data-total={stageTotal}
    data-zoe={open ? 'only' : undefined}
    {...(portraits.length ? { role: 'group', 'aria-roledescription': 'slideshow', 'aria-label': 'Stepping video and case study images' } : {})}
  >
    <!-- Case portraits, after the video. Each image opens its case; it duplicates the caption link, so it
         is left out of the tab order and hidden from screen readers -->
    {portraits.map((p, i) => (
      <a class="hx-pslide" href={p.href} data-pslide={i + 1} data-title={p.title} tabindex="-1" aria-hidden="true" hidden>
        <img src={p.src} alt="" loading="lazy" />
      </a>
    ))}
    <div class="hx-media" role="img" aria-label={open ? 'Zoetrope of Scott stepping, six frames, turns as you scroll or move across it' : 'Video of Scott stepping, scrubs as you scroll or move across it'} data-media>
    {!open && <video
      src="/media/stepping-scrub.mp4"
      poster="/media/stepping-poster.jpg"
      muted
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>}
    <!-- The easter egg: the same stepping, as a zoetrope. Six poses are interleaved in bands one device
         pixel high, and a slotted mask over them shows one pose at a time as you scroll or move across -->
    <div class="hx-zoe" hidden={!open}>
      <div class="zoe-fig">
        <span class="zoe-l" style="--k: 0"></span>
        <span class="zoe-l" style="--k: 1"></span>
        <span class="zoe-l" style="--k: 2"></span>
        <span class="zoe-l" style="--k: 3"></span>
        <span class="zoe-l" style="--k: 4"></span>
        <span class="zoe-l" style="--k: 5"></span>
        <span class="zoe-mask"></span>
      </div>
    </div>
    </div>
    <div class="hx-vcap">
      <span class="vcap-text">
        {open && (
          <span>
            <span class="d-block">Becoming Tortoise: Designing a Participatory Installation on the action of stepping</span>
            <span class="d-block time zt">Mask y-axis <strong data-zmask>0</strong><span class="zc">Lenticular <strong data-zframe>1</strong> of 6</span></span>
          </span>
        )}
        {!open && <>
        <span data-cap="video">
          <span class="d-block">Becoming Tortoise: Designing a Participatory Installation on the action of stepping</span>
          <span class="d-block time"><strong data-vcap>0:00.0</strong> / <span data-vdur>1:01.6</span></span>
        </span>
        <span data-cap="zoetrope" hidden>
          <span class="d-block">Zoetrope image of <em>Stepping</em></span>
          <span class="d-block time zt">Mask y-axis <strong data-zmask>0</strong><span class="zc">Lenticular <strong data-zframe>1</strong> of 6</span></span>
        </span>
        </>}
      </span>
      {portraits.length > 0 && (
        <a class="vcap-case" href={portraits[0].href} aria-live="polite" hidden>
          <strong data-pnum>02</strong> / {pad(stageTotal)} · <span data-pname>{portraits[0].title}</span>
        </a>
      )}
      {!open && (
        <button class="zoe-toggle" type="button" aria-pressed="false" aria-label="Show as a zoetrope" title="Zoetrope">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false"><path d="M2 2H20V20H2Z M7 6V16 M11 6V16 M15 6V16" stroke="currentColor" stroke-width="2.4" fill="none"></path></svg>
        </button>
      )}
      {portraits.length > 0 && <>
        <button class="icon-btn vcap-nav" type="button" data-pstep="-1" aria-label="Previous slide">
          <svg width="20" height="18" viewBox="0 0 22 20" aria-hidden="true" focusable="false"><path d="M21 10H3M11 2L3 10L11 18" stroke="currentColor" stroke-width="3" fill="none"></path></svg>
        </button>
        <button class="icon-btn vcap-nav" type="button" data-pstep="1" aria-label="Next slide">
          <svg width="20" height="18" viewBox="0 0 22 20" aria-hidden="true" focusable="false"><path d="M1 10H19M11 2L19 10L11 18" stroke="currentColor" stroke-width="3" fill="none"></path></svg>
        </button>
      </>}
    </div>
  </div>

  {!split && <>
  <a class="hx-tile hx-cta b-tileP" href="/contact/"><span class="a">→</span><span class="t">Get in touch</span></a>

  <div class="hx-slides" role="group" aria-roledescription="slideshow" aria-label="Case study images">
    <!-- The image and the caption both open the case showing. The image link is a duplicate of the
         caption link, so it is left out of the tab order and hidden from screen readers -->
    <a class="sl-wrap" href={slides[0]?.href} data-slink tabindex="-1" aria-hidden="true">
      {slides.map((s, i) => (
        <div class="sl" data-i={i} data-title={s.title} data-href={s.href} style={`opacity: ${i === 0 ? 1 : 0}`}>
          {s.thumbnail
            ? <img src={s.thumbnail} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
            : <div class="thumb-placeholder">Image · {s.title}</div>}
        </div>
      ))}
    </a>
    <div class="hx-sbar">
      <a class="hx-scap" href={slides[0]?.href} data-slink aria-live="polite"><strong data-scap>01</strong> / {pad(slides.length)} · <span data-sname>{slides[0]?.title}</span></a>
      <button class="icon-btn sl-nav" type="button" data-step="-1" aria-label="Previous case image">
        <svg width="20" height="18" viewBox="0 0 22 20" aria-hidden="true" focusable="false"><path d="M21 10H3M11 2L3 10L11 18" stroke="currentColor" stroke-width="3" fill="none"></path></svg>
      </button>
      <button class="icon-btn sl-nav" type="button" data-step="1" aria-label="Next case image">
        <svg width="20" height="18" viewBox="0 0 22 20" aria-hidden="true" focusable="false"><path d="M1 10H19M11 2L19 10L11 18" stroke="currentColor" stroke-width="3" fill="none"></path></svg>
      </button>
    </div>
  </div>

  <a class="hx-tile hx-work b-tileS" href="#work"><span class="a">↓</span><span class="t">See my work</span></a>
  </>}
</section>

<script is:inline>
  // On desktop the headline grows to fill the space above the name box: the largest size at which
  // it fits the cell's width without breaking a word and the height left on the first screen.
  // Stacked (820px and below) it keeps the CSS size, which matches the case study titles.
  // This runs inline, before the first paint, so the size never visibly changes. If the web fonts
  // are not loaded yet (a first visit), the headline stays invisible until they are and it is sized.
  (() => {
    const hero = document.querySelector('.hx-hero');
    const strap = hero && hero.querySelector('.hx-strap');
    const h1 = strap && strap.querySelector('.hx-h1');
    const bottom = strap && strap.querySelector('.hx-bottom');
    const grid = hero && hero.dataset.layout === 'grid';
    // The open layout keeps the headline to four lines, as designed, so its size follows the width
    // steadily instead of jumping as extra lines fit on a taller window. The height is only a ceiling
    const maxLines = hero && hero.dataset.layout === 'open' ? 4 : Infinity;
    // In the grid layout the tile row sits below the headline's cell; in the split layout the cell is the full height
    const row2 = grid ? hero.querySelector('.hx-cta') : null;
    if (!h1 || !bottom || (grid && !row2)) return;
    const desktop = matchMedia('(min-width: 821px)');

    function fit() {
      h1.style.fontSize = '';
      h1.style.overflowWrap = '';
      if (!desktop.matches) return;
      const header = document.querySelector('.site-header');
      const s = getComputedStyle(strap);
      const hs = getComputedStyle(hero);
      const below = row2 ? row2.offsetHeight + (parseFloat(getComputedStyle(hero).rowGap) || 0) : 0;
      const room = window.innerHeight - (header ? header.offsetHeight : 0) - below
        - parseFloat(s.paddingTop) - parseFloat(s.paddingBottom)
        - parseFloat(hs.paddingTop) - parseFloat(hs.paddingBottom)
        - (parseFloat(s.rowGap) || 0) - bottom.offsetHeight
        - (parseFloat(getComputedStyle(h1).marginTop) || 0);
      h1.style.overflowWrap = 'normal'; // so a word too wide for the cell shows up as overflow
      const lineHeight = parseFloat(getComputedStyle(h1).lineHeight) / parseFloat(getComputedStyle(h1).fontSize) || 0.95;
      let lo = 40;
      let hi = 200;
      for (let k = 0; k < 14; k++) {
        const mid = (lo + hi) / 2;
        h1.style.fontSize = mid + 'px';
        const lines = Math.round(h1.scrollHeight / (mid * lineHeight));
        if (h1.scrollHeight <= room && h1.scrollWidth <= h1.clientWidth && lines <= maxLines) lo = mid; else hi = mid;
      }
      h1.style.fontSize = Math.floor(lo) + 'px';
    }

    const show = () => { fit(); h1.style.visibility = ''; };
    const fonts = document.fonts;
    // check() is true once the headline's font is loaded (on a return visit it is in the cache).
    // fit() measures first, which starts the font loading if it has not started
    const css = getComputedStyle(h1);
    const fontReady = () => !fonts || fonts.check(css.fontWeight + ' 40px ' + css.fontFamily);
    if (fontReady()) {
      fit();
    } else {
      if (desktop.matches) h1.style.visibility = 'hidden';
      fit();
      fonts.ready.then(show);
      setTimeout(show, 1500); // never leave it hidden if the fonts are slow or fail
    }

    let queued = false;
    window.addEventListener('resize', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; fit(); });
    });
  })();
</script>

<style>
  .hx-hero {
    display: grid;
    grid-template-columns: 28fr 32fr 40fr;
    /* On desktop the hero fills the rest of the first screen below the sticky header */
    grid-template-rows: 1fr clamp(150px, 15vw, 240px);
    min-height: calc(100svh - var(--header-tall, 72px));
    gap: var(--rule);
    background: var(--ink);
    border-bottom: var(--rule) solid var(--ink);
  }
  .hx-strap {
    grid-column: 1 / 3;
    grid-row: 1;
    background: var(--bg);
    padding: var(--step-32-64) var(--step-16-32);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--step-32-64);
    container-type: inline-size;
    min-width: 0;
  }
  .hx-h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 9.4cqi, 132px);
    --lh: .95;
    letter-spacing: -.035em;
    overflow-wrap: break-word;
  }
  .hx-bottom { align-self: flex-start; }
  .hx-name {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px var(--step-16-32);
    border: var(--rule) solid var(--ink);
    background: var(--bg);
    font: 400 clamp(12px, 1.05vw, 15px) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .hx-name .l1 { font-weight: 600; }
  .hx-name .l2, .hx-name .l3 { font-size: .9em; --lh: 1.5; }
  .hx-name .l3 { font-weight: 500; }

  .hx-video {
    grid-column: 3;
    grid-row: 1;
    position: relative;
    background: var(--bg);
    overflow: hidden;
    touch-action: pan-y;
    min-height: 0;
  }
  /* The clip and its poster have a few dark rows at the top and bottom, which read as extra rules
     against the header and the tiles below. The video is drawn a little taller so the cell crops them */
  .hx-video video {
    position: absolute;
    top: -1.2%;
    left: 0;
    width: 100%;
    height: 102.4%;
    object-fit: cover;
  }
  .hx-media { position: absolute; inset: 0; }
  .hx-vcap {
    position: absolute;
    left: var(--step-8-16);
    right: var(--step-8-16);
    bottom: var(--step-8-16);
    max-width: 466px;
    display: flex;
    border: var(--rule) solid var(--ink);
    background: var(--bg);
    font: 500 clamp(11px, .85vw, 12px) / 1.4 var(--font-mono);
    letter-spacing: .02em;
  }
  .vcap-text { flex: 1 1 auto; min-width: 0; padding: 8px 16px; }
  .vcap-text [hidden] { display: none; }

  /* The zoetrope switch: a small boxed button at the end of the caption, filled when it is on */
  .zoe-toggle {
    flex: 0 0 auto;
    width: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-left: var(--rule) solid var(--ink);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
  }
  .zoe-toggle:hover { background: var(--accent); color: var(--on-accent); }
  .zoe-toggle[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .zoe-toggle:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .zoe-toggle:active { transform: translate(1px, 1px); }

  /* Zoetrope. --u is one device pixel (set by the script); --f is the pose showing, 0 to 5 */
  .hx-zoe {
    --u: 1px;
    --f: 0;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 32px 128px;
    background: var(--bg);
    container-type: size;
  }
  .hx-zoe[hidden] { display: none; }
  .zoe-fig {
    position: relative;
    width: min(100cqw, 100cqh * 880 / 850);
    aspect-ratio: 880 / 850;
  }
  /* Each layer is one pose from the strip, kept only on its own band of every six */
  .zoe-l {
    position: absolute;
    inset: 0;
    background: url('/media/stepping-zoetrope.webp') no-repeat;
    background-size: 700% 100%;
    background-position: calc(var(--k) * 100% / 6) 0;
    --a: calc(var(--k) * var(--u));
    --b: calc((var(--k) + 1) * var(--u));
    -webkit-mask-image: repeating-linear-gradient(180deg, transparent 0 var(--a), #000 var(--a) var(--b), transparent var(--b) calc(6 * var(--u)));
    mask-image: repeating-linear-gradient(180deg, transparent 0 var(--a), #000 var(--a) var(--b), transparent var(--b) calc(6 * var(--u)));
  }
  /* The slotted drum: covers five bands in six, and moving it a band shows the next pose */
  .zoe-mask {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(180deg, transparent 0 var(--u), var(--bg) var(--u) calc(6 * var(--u)));
    background-size: 100% calc(6 * var(--u));
    background-position: 0 calc(var(--f) * var(--u));
  }
  /* Case portrait slides: filling the cell, grey until pointed at, like the grid slideshow */
  .hx-pslide { position: absolute; inset: 0; display: block; background: var(--thumb); cursor: var(--cursor-link); }
  .hx-pslide[hidden], .hx-media[hidden], .vcap-text[hidden], .vcap-case[hidden], .zoe-toggle[hidden] { display: none; }
  .hx-pslide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter .2s ease;
  }
  .hx-video:has(.hx-pslide:hover, .vcap-case:hover, .vcap-case:focus-visible) .hx-pslide img { filter: none; }
  .vcap-case {
    flex: 1 1 auto;
    min-width: 0;
    display: block;
    padding: 0 16px;
    --lh-fixed: 44px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
  }
  .vcap-case:hover, .vcap-case:focus-visible { background: var(--accent); color: var(--on-accent); }
  .vcap-case:hover [data-pname], .vcap-case:focus-visible [data-pname] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .vcap-case:focus-visible { outline: 3px solid var(--ink); outline-offset: -3px; }
  .vcap-nav {
    flex: 0 0 auto;
    width: 44px;
    min-height: 44px;
    height: auto;
    border: 0;
    border-left: var(--rule) solid var(--ink);
    background: var(--bg);
  }
  .vcap-nav:hover { background: var(--ink); color: var(--bg); }
  .vcap-nav:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .hx-video:not(.scrub) { cursor: auto; }

  .d-block { display: block; }
  .time { margin-top: 4px; font-variant-numeric: tabular-nums; }
  /* The zoetrope readout stays on one line */
  .zt { white-space: nowrap; }
  .zc { margin-left: 16px; }
  /* Room for three digits, so Lenticular stays put as the number grows */
  .zt [data-zmask] { display: inline-block; min-width: 3.5ch; }

  .hx-tile {
    container-type: inline-size;
    min-width: 0;
    padding: var(--step-16-32);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
  }
  .hx-tile .t {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 10cqi, 48px);
    --lh: 1;
    letter-spacing: -.03em;
  }
  .hx-tile .a {
    font: 600 14px var(--font-mono); --lh: 1.3;
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .hx-cta { grid-column: 1; grid-row: 2; }
  .hx-work { grid-column: 3; grid-row: 2; }

  .hx-slides {
    grid-column: 2;
    grid-row: 2;
    position: relative;
    background: var(--bg);
    overflow: hidden;
    touch-action: pan-y;
    min-width: 0;
  }
  .sl-wrap, .sl { position: absolute; inset: 0; }
  .sl-wrap { display: block; }
  .sl img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    filter: grayscale(1) contrast(1.05);
    transition: filter .2s ease;
  }
  /* Pointing at the image or caption brings the image into colour */
  .hx-slides:has(.sl-wrap:hover, .hx-scap:hover, .hx-scap:focus-visible) .sl img { filter: none; }
  .sl .thumb-placeholder { width: 100%; height: 100%; padding: 16px; }
  /* Caption with the previous and next arrows, boxed and joined like the lightbox controls */
  .hx-sbar {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: flex;
    align-items: stretch;
    border: var(--rule) solid var(--ink);
    background: var(--bg);
  }
  .hx-scap {
    flex: 1 1 auto;
    min-width: 0;
    display: block;
    padding: 0 8px;
    font: 500 clamp(11px, .85vw, 12px) / 44px var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
  }
  .hx-scap:hover, .hx-scap:focus-visible { background: var(--accent); color: var(--on-accent); }
  .hx-scap:hover [data-sname], .hx-scap:focus-visible [data-sname] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .hx-scap:focus-visible { outline: 3px solid var(--ink); outline-offset: -3px; }
  .sl-nav {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border: 0;
    border-left: var(--rule) solid var(--ink);
    background: var(--bg);
  }
  /* The rule above outranks .icon-btn:hover, so the hover fill is restated here */
  .sl-nav:hover { background: var(--ink); color: var(--bg); }
  .sl-nav:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }

  .scrub { cursor: var(--cursor-scrub); }

  /* Split layout: headline column and full-height video, the name box and tiles joined in one ruled card */
  .hx-split { grid-template-columns: 59fr 41fr; grid-template-rows: 1fr; }
  .hx-split .hx-strap { grid-column: 1; grid-row: 1; }
  .hx-split .hx-video { grid-column: 2; grid-row: 1; }
  .hx-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--rule);
    width: min(100%, 760px);
    background: var(--ink);
    border: var(--rule) solid var(--ink);
  }
  .hx-card .hx-name { grid-column: 1 / -1; border: 0; }
  .hx-card .hx-tile { grid-column: auto; grid-row: auto; min-height: clamp(96px, 9vw, 136px); justify-content: flex-end; }

  /* Open layout: inside the page wrapper (the padding does the wrapper's job, so the zoetrope can run
     past it to the window's edge), no ruled cells, the tiles boxed and apart */
  .hx-open {
    grid-template-columns: 66fr 34fr;
    column-gap: var(--step-32-64);
    padding-inline: max(var(--gutter), calc((100% - var(--max)) / 2 + var(--gutter)));
    padding-block: var(--step-16-32) var(--step-32-64);
    background: none;
    overflow-x: clip;
  }
  /* Above the zoetrope, whose drum is drawn in the page colour */
  .hx-open .hx-strap { position: relative; z-index: 1; padding: 0; background: none; }
  /* A little more space between the logo and the headline, without moving the zoetrope */
  .hx-open .hx-h1 { margin-top: var(--step-16-32); }
  .hx-open .hx-card {
    gap: var(--step-32-64) 16px;
    width: min(100%, 680px);
    background: none;
    border: 0;
  }
  .hx-open .hx-card .hx-name { padding: 0 8px; background: none; }
  .hx-open .hx-card .hx-tile { border: var(--rule) solid var(--ink); }
  .hx-open .hx-video { background: none; overflow: visible; }
  /* The zoetrope as tall as the column, wider than it, set a little right so the reach runs off the edge */
  .hx-open .hx-zoe { padding: 0; background: none; }
  .hx-open .zoe-fig { flex: none; width: auto; height: 100cqh; transform: translateX(7%); }
  .hx-open .hx-vcap { left: auto; right: 0; bottom: 0; width: min(100%, 360px); z-index: 1; }
  .hx-open .hx-pslide { border: var(--rule) solid var(--ink); }

  @media (max-width: 820px) {
    .hx-hero { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto auto auto; }
    .hx-strap { grid-column: 1 / -1; grid-row: 1; }
    /* Stacked, the headline matches the case study title size (CaseStudy.astro .cs-title) */
    .hx-h1 { font-size: clamp(44px, 7.6vw, 128px); }
    .hx-video { grid-column: 1 / -1; grid-row: 2; aspect-ratio: 4 / 5; }
    .hx-cta { grid-column: 1; grid-row: 3; min-height: 150px; }
    .hx-work { grid-column: 2; grid-row: 3; min-height: 150px; }
    .hx-slides { grid-column: 1 / -1; grid-row: 4; aspect-ratio: 4 / 3; }
    .hx-split { grid-template-columns: 1fr; grid-template-rows: auto auto; }
    .hx-split .hx-video { grid-column: 1; grid-row: 2; }
    .hx-open { row-gap: 32px; }
    /* Stacked, the figure sits centred and the caption runs the full width, like the tiles above */
    .hx-open .zoe-fig { transform: none; }
    .hx-open .hx-vcap { left: 0; width: 100%; max-width: none; }
  }
</style>

<script>
  // The video never plays by itself. Page scroll and horizontal pointer position each map to the
  // whole clip. The case slideshow beside it has arrows instead. Seeks queue: while one is in progress only the latest target is kept.
  const cell = document.querySelector<HTMLElement>('.hx-video');
  const video = cell?.querySelector('video');
  const vcap = cell?.querySelector<HTMLElement>('[data-vcap]');
  const vdur = cell?.querySelector<HTMLElement>('[data-vdur]');
  const slidesCell = document.querySelector<HTMLElement>('.hx-slides');
  const slides = Array.from(slidesCell?.querySelectorAll<HTMLElement>('.sl') ?? []);
  const scap = slidesCell?.querySelector<HTMLElement>('[data-scap]');
  const sname = slidesCell?.querySelector<HTMLElement>('[data-sname]');

  const FALLBACK_DURATION = 61.6;
  let target: number | null = null;
  let currentSlide = 0;

  const fmt = (t: number) => {
    const m = Math.floor(t / 60);
    const s = t - m * 60;
    return `${m}:${s < 10 ? '0' : ''}${s.toFixed(1)}`;
  };
  const duration = () => (video && Number.isFinite(video.duration) && video.duration > 0 ? video.duration : FALLBACK_DURATION);

  function seek(t: number) {
    if (!video) return;
    t = Math.max(0, Math.min(duration() - 0.05, t));
    target = t;
    if (ready && !video.seeking) video.currentTime = t;
    if (vcap) vcap.textContent = fmt(t);
  }

  // iOS Safari loads no video data until the video has played once, whatever preload says, and
  // hides the poster as soon as currentTime is set. So: start and immediately pause the (muted)
  // video to make it load, and only seek once a frame is ready; until then the poster stays.
  let ready = false;
  const markReady = () => {
    if (ready || !video || video.readyState < 2) return;
    ready = true;
    if (target !== null) video.currentTime = target;
  };
  const prime = () => {
    if (!video || ready) return;
    const p = video.play();
    if (p) p.then(() => { video.pause(); markReady(); }).catch(() => { /* not allowed yet: retried on first touch */ });
  };
  video?.addEventListener('loadeddata', markReady);
  video?.addEventListener('canplay', markReady);
  prime();
  // Low Power Mode refuses muted autoplay too; a touch counts as permission
  window.addEventListener('touchstart', prime, { once: true, passive: true });

  video?.addEventListener('seeked', () => {
    if (video && target !== null && Math.abs(video.currentTime - target) > 0.04) video.currentTime = target;
  });
  video?.addEventListener('loadedmetadata', () => {
    if (vdur) vdur.textContent = fmt(duration());
  });

  const slideLinks = slidesCell?.querySelectorAll<HTMLAnchorElement>('[data-slink]') ?? [];

  function showSlide(i: number) {
    const n = slides.length;
    if (!n) return;
    i = ((i % n) + n) % n;
    if (i === currentSlide) return;
    currentSlide = i;
    slides.forEach((el, k) => { el.style.opacity = k === i ? '1' : '0'; });
    if (scap) scap.textContent = String(i + 1).padStart(2, '0');
    if (sname) sname.textContent = slides[i].dataset.title ?? '';
    slideLinks.forEach((a) => { a.href = slides[i].dataset.href ?? a.href; });
  }

  const fraction = (e: PointerEvent, el: HTMLElement) => {
    const r = el.getBoundingClientRect();
    return Math.min(0.9999, Math.max(0, (e.clientX - r.left) / r.width));
  };

  // Zoetrope easter egg: the switch in the caption swaps the video for the same stepping as a
  // zoetrope. Scroll and pointer drive it as they drive the video. The choice lasts for the visit.
  const media = cell?.querySelector<HTMLElement>('[data-media]');
  const zoe = cell?.querySelector<HTMLElement>('.hx-zoe');
  const zoeToggle = cell?.querySelector<HTMLButtonElement>('.zoe-toggle');
  const zframe = cell?.querySelector<HTMLElement>('[data-zframe]');
  const zmask = cell?.querySelector<HTMLElement>('[data-zmask]');
  const POSES = 6;
  const SCROLL_PER_POSE = 28; // px of page scroll per pose
  let zoetrope = false;
  let pose = -1;

  // One band is one device pixel, so the bands line up with the screen's pixels at any zoom
  const setUnit = () => zoe?.style.setProperty('--u', `${1 / (window.devicePixelRatio || 1)}px`);
  function showPose(n: number) {
    // The mask's position before it wraps, so it reads as travelling, not swapping
    if (zmask) zmask.textContent = String(n);
    n = ((n % POSES) + POSES) % POSES;
    if (n === pose || !zoe) return;
    pose = n;
    zoe.style.setProperty('--f', String(n));
    if (zframe) zframe.textContent = String(n + 1);
  }
  function setZoetrope(on: boolean) {
    if (!zoe || !video || !zoeToggle || !media) return;
    zoetrope = on;
    zoe.hidden = !on;
    video.hidden = on;
    zoeToggle.setAttribute('aria-pressed', String(on));
    zoeToggle.setAttribute('aria-label', on ? 'Show as video' : 'Show as a zoetrope');
    zoeToggle.title = on ? 'Video' : 'Zoetrope';
    media.setAttribute('aria-label', on
      ? 'Zoetrope of Scott stepping, six frames, turns as you scroll or move across it'
      : 'Video of Scott stepping, scrubs as you scroll or move across it');
    cell?.querySelectorAll<HTMLElement>('[data-cap]').forEach((c) => { c.hidden = c.dataset.cap !== (on ? 'zoetrope' : 'video'); });
    if (on) { setUnit(); pose = -1; showPose(Math.floor(window.scrollY / SCROLL_PER_POSE)); }
    try { sessionStorage.setItem('hero-zoetrope', on ? '1' : ''); } catch { /* storage unavailable */ }
  }
  zoeToggle?.addEventListener('click', () => setZoetrope(!zoetrope));
  window.addEventListener('resize', () => { if (zoetrope) setUnit(); });
  try { if (sessionStorage.getItem('hero-zoetrope') === '1') setZoetrope(true); } catch { /* storage unavailable */ }
  // The open layout has no video: the zoetrope is always on
  if (cell?.dataset.zoe === 'only' && zoe) {
    zoetrope = true;
    setUnit();
    showPose(Math.floor(window.scrollY / SCROLL_PER_POSE));
  }

  // Split layout: the video (or zoetrope) is slide 0 of a slideshow of case portraits in the same cell,
  // moved only by the arrows in its caption. On a case slide the caption is a link to the case
  const pslides = Array.from(cell?.querySelectorAll<HTMLAnchorElement>('[data-pslide]') ?? []);
  const vtext = cell?.querySelector<HTMLElement>('.vcap-text');
  const vcase = cell?.querySelector<HTMLAnchorElement>('.vcap-case');
  const pnum = vcase?.querySelector<HTMLElement>('[data-pnum]');
  const pname = vcase?.querySelector<HTMLElement>('[data-pname]');
  let stage = 0;
  function showStage(i: number) {
    const n = pslides.length + 1;
    i = ((i % n) + n) % n;
    if (i === stage || !cell || !media || !vtext || !vcase) return;
    stage = i;
    const onCase = i > 0;
    media.hidden = onCase;
    vtext.hidden = onCase;
    if (zoeToggle) zoeToggle.hidden = onCase;
    vcase.hidden = !onCase;
    cell.classList.toggle('scrub', !onCase);
    pslides.forEach((s, k) => { s.hidden = k !== i - 1; });
    if (onCase) {
      const s = pslides[i - 1];
      vcase.href = s.href;
      if (pnum) pnum.textContent = String(i + 1).padStart(2, '0');
      if (pname) pname.textContent = s.dataset.title ?? '';
    }
  }
  cell?.querySelectorAll<HTMLButtonElement>('[data-pstep]').forEach((btn) => {
    btn.addEventListener('click', () => showStage(stage + Number(btn.dataset.pstep)));
  });

  cell?.addEventListener('pointermove', (e) => {
    if (stage > 0) return;
    // Two turns of the drum across the box
    if (zoetrope) showPose(Math.floor(fraction(e, cell) * POSES * 2));
    else seek(fraction(e, cell) * duration());
  });
  // The slideshow moves only with its arrows, and wraps round at either end
  slidesCell?.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
    btn.addEventListener('click', () => showSlide(currentSlide + Number(btn.dataset.step)));
  });

  let queued = false;
  window.addEventListener('scroll', () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const p = Math.min(1, window.scrollY / max);
      if (zoetrope) showPose(Math.floor(window.scrollY / SCROLL_PER_POSE));
      else seek(p * duration());
    });
  }, { passive: true });
</script>
