---
import { caseUrl, getCases } from '../lib/content';
import { resolveImageSrc, THUMB_WIDTH } from '../lib/images';

// The slideshow shows the first five case studies' thumbnails
const slides = (await getCases()).slice(0, 5).map((c) => ({
  title: c.data.title,
  href: caseUrl(c),
  thumbnail: resolveImageSrc(c.filePath, c.data.thumbnail, THUMB_WIDTH),
}));
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="hx-hero" aria-label="Introduction">
  <div class="hx-strap">
    <h1 class="hx-h1">I research encounters between people and technology, to better designed products.</h1>
    <div class="hx-name">
      <span class="l1">Dr Scott Robinson</span>
      <span class="l2">London, UK • Hybrid or Remote • Permanent or Contract</span>
      <span class="l3">User Research <span aria-hidden="true">⇄</span><span class="visually-hidden">, moving back and forth with </span> UX and Product Design <span aria-hidden="true">⇄</span><span class="visually-hidden">, moving back and forth with </span> Product Strategy</span>
    </div>
  </div>

  <div class="hx-video scrub" role="img" aria-label="Video of Scott stepping, scrubs as you scroll or move across it">
    <video
      src="/media/stepping-scrub.mp4"
      poster="/media/stepping-poster.jpg"
      muted
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>
    <span class="hx-vcap">
      <span class="d-block">Becoming Tortoise: Designing a Participatory Installation on the action of stepping</span>
      <span class="d-block time"><strong data-vcap>0:00.0</strong> / <span data-vdur>1:01.6</span></span>
    </span>
  </div>

  <a class="hx-tile hx-cta b-tileP" href="#contact"><span class="a">→</span><span class="t">Get in touch</span></a>

  <div class="hx-slides" role="group" aria-roledescription="slideshow" aria-label="Case study images">
    <!-- The image and the caption both open the case showing. The image link is a duplicate of the
         caption link, so it is left out of the tab order and hidden from screen readers -->
    <a class="sl-wrap" href={slides[0]?.href} data-slink tabindex="-1" aria-hidden="true">
      {slides.map((s, i) => (
        <div class="sl" data-i={i} data-title={s.title} data-href={s.href} style={`opacity: ${i === 0 ? 1 : 0}`}>
          {s.thumbnail
            ? <img src={s.thumbnail} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
            : <div class="thumb-placeholder">Image · {s.title}</div>}
        </div>
      ))}
    </a>
    <div class="hx-sbar">
      <a class="hx-scap" href={slides[0]?.href} data-slink aria-live="polite"><strong data-scap>01</strong> / {pad(slides.length)} · <span data-sname>{slides[0]?.title}</span></a>
      <button class="icon-btn sl-nav" type="button" data-step="-1" aria-label="Previous case image">
        <svg width="20" height="18" viewBox="0 0 22 20" aria-hidden="true" focusable="false"><path d="M21 10H3M11 2L3 10L11 18" stroke="currentColor" stroke-width="3" fill="none"></path></svg>
      </button>
      <button class="icon-btn sl-nav" type="button" data-step="1" aria-label="Next case image">
        <svg width="20" height="18" viewBox="0 0 22 20" aria-hidden="true" focusable="false"><path d="M1 10H19M11 2L19 10L11 18" stroke="currentColor" stroke-width="3" fill="none"></path></svg>
      </button>
    </div>
  </div>

  <a class="hx-tile hx-work b-tileS" href="#work"><span class="a">↓</span><span class="t">See my work</span></a>
</section>

<style>
  .hx-hero {
    display: grid;
    grid-template-columns: 28fr 32fr 40fr;
    /* On desktop the hero fills the rest of the first screen below the sticky header */
    grid-template-rows: 1fr clamp(150px, 15vw, 240px);
    min-height: calc(100svh - var(--header-h, 72px));
    gap: var(--rule);
    background: var(--ink);
    border-bottom: var(--rule) solid var(--ink);
  }
  .hx-strap {
    grid-column: 1 / 3;
    grid-row: 1;
    background: var(--bg);
    padding: clamp(28px, 4.4vw, 64px) clamp(20px, 3.3vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(24px, 3vw, 48px);
    container-type: inline-size;
    min-width: 0;
  }
  .hx-h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 9.4cqi, 132px);
    line-height: .95;
    letter-spacing: -.035em;
    overflow-wrap: break-word;
  }
  .hx-name {
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(14px, 1.6vw, 20px) clamp(18px, 2vw, 28px);
    border: var(--rule) solid var(--ink);
    background: var(--bg);
    font: 400 clamp(12px, 1.05vw, 15px) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .hx-name .l1 { font-weight: 600; }
  .hx-name .l2, .hx-name .l3 { font-size: .9em; line-height: 1.5; }
  .hx-name .l3 { font-weight: 500; }

  .hx-video {
    grid-column: 3;
    grid-row: 1;
    position: relative;
    background: var(--bg);
    overflow: hidden;
    touch-action: pan-y;
    min-height: 0;
  }
  /* The clip and its poster have a few dark rows at the top and bottom, which read as extra rules
     against the header and the tiles below. The video is drawn a little taller so the cell crops them */
  .hx-video video {
    position: absolute;
    top: -1.2%;
    left: 0;
    width: 100%;
    height: 102.4%;
    object-fit: cover;
  }
  .hx-vcap {
    position: absolute;
    left: clamp(10px, 1.2vw, 16px);
    right: clamp(10px, 1.2vw, 16px);
    bottom: clamp(10px, 1.2vw, 16px);
    max-width: 420px;
    padding: 10px 14px;
    line-height: 1.4;
    border: var(--rule) solid var(--ink);
    background: var(--bg);
    font: 500 clamp(11px, .85vw, 12px) var(--font-mono);
    letter-spacing: .02em;
  }
  .d-block { display: block; }
  .time { margin-top: 4px; font-variant-numeric: tabular-nums; }

  .hx-tile {
    container-type: inline-size;
    min-width: 0;
    padding: clamp(14px, 1.6vw, 24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
  }
  .hx-tile .t {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 10cqi, 48px);
    line-height: 1;
    letter-spacing: -.03em;
  }
  .hx-tile .a {
    font: 600 14px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .hx-cta { grid-column: 1; grid-row: 2; }
  .hx-work { grid-column: 3; grid-row: 2; }

  .hx-slides {
    grid-column: 2;
    grid-row: 2;
    position: relative;
    background: var(--bg);
    overflow: hidden;
    touch-action: pan-y;
    min-width: 0;
  }
  .sl-wrap, .sl { position: absolute; inset: 0; }
  .sl-wrap { display: block; }
  .sl img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    filter: grayscale(1) contrast(1.05);
    transition: filter .2s ease;
  }
  /* Pointing at the image or caption brings the image into colour */
  .hx-slides:has(.sl-wrap:hover, .hx-scap:hover, .hx-scap:focus-visible) .sl img { filter: none; }
  .sl .thumb-placeholder { width: 100%; height: 100%; padding: 16px; }
  /* Caption with the previous and next arrows, boxed and joined like the lightbox controls */
  .hx-sbar {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: flex;
    align-items: stretch;
    border: var(--rule) solid var(--ink);
    background: var(--bg);
  }
  .hx-scap {
    flex: 1 1 auto;
    min-width: 0;
    display: block;
    padding: 0 10px;
    font: 500 clamp(11px, .85vw, 12px) / 44px var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
  }
  .hx-scap:hover, .hx-scap:focus-visible { background: var(--accent); color: var(--on-accent); }
  .hx-scap:hover [data-sname], .hx-scap:focus-visible [data-sname] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .hx-scap:focus-visible { outline: 3px solid var(--ink); outline-offset: -3px; }
  .sl-nav {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border: 0;
    border-left: var(--rule) solid var(--ink);
    background: var(--bg);
  }
  /* The rule above outranks .icon-btn:hover, so the hover fill is restated here */
  .sl-nav:hover { background: var(--ink); color: var(--bg); }
  .sl-nav:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }

  .scrub { cursor: var(--cursor-scrub); }

  @media (max-width: 820px) {
    .hx-hero { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto auto auto; }
    .hx-strap { grid-column: 1 / -1; grid-row: 1; }
    /* Stacked, the headline matches the case study title size (CaseStudy.astro .cs-title) */
    .hx-h1 { font-size: clamp(44px, 7.6vw, 128px); }
    .hx-video { grid-column: 1 / -1; grid-row: 2; aspect-ratio: 4 / 5; }
    .hx-cta { grid-column: 1; grid-row: 3; min-height: 150px; }
    .hx-work { grid-column: 2; grid-row: 3; min-height: 150px; }
    .hx-slides { grid-column: 1 / -1; grid-row: 4; aspect-ratio: 4 / 3; }
  }
</style>

<script>
  // The video never plays by itself. Page scroll and horizontal pointer position each map to the
  // whole clip. The case slideshow beside it has arrows instead. Seeks queue: while one is in progress only the latest target is kept.
  const cell = document.querySelector<HTMLElement>('.hx-video');
  const video = cell?.querySelector('video');
  const vcap = cell?.querySelector<HTMLElement>('[data-vcap]');
  const vdur = cell?.querySelector<HTMLElement>('[data-vdur]');
  const slidesCell = document.querySelector<HTMLElement>('.hx-slides');
  const slides = Array.from(slidesCell?.querySelectorAll<HTMLElement>('.sl') ?? []);
  const scap = slidesCell?.querySelector<HTMLElement>('[data-scap]');
  const sname = slidesCell?.querySelector<HTMLElement>('[data-sname]');

  const FALLBACK_DURATION = 61.6;
  let target: number | null = null;
  let currentSlide = 0;

  const fmt = (t: number) => {
    const m = Math.floor(t / 60);
    const s = t - m * 60;
    return `${m}:${s < 10 ? '0' : ''}${s.toFixed(1)}`;
  };
  const duration = () => (video && Number.isFinite(video.duration) && video.duration > 0 ? video.duration : FALLBACK_DURATION);

  function seek(t: number) {
    if (!video) return;
    t = Math.max(0, Math.min(duration() - 0.05, t));
    target = t;
    if (ready && !video.seeking) video.currentTime = t;
    if (vcap) vcap.textContent = fmt(t);
  }

  // iOS Safari loads no video data until the video has played once, whatever preload says, and
  // hides the poster as soon as currentTime is set. So: start and immediately pause the (muted)
  // video to make it load, and only seek once a frame is ready; until then the poster stays.
  let ready = false;
  const markReady = () => {
    if (ready || !video || video.readyState < 2) return;
    ready = true;
    if (target !== null) video.currentTime = target;
  };
  const prime = () => {
    if (!video || ready) return;
    const p = video.play();
    if (p) p.then(() => { video.pause(); markReady(); }).catch(() => { /* not allowed yet: retried on first touch */ });
  };
  video?.addEventListener('loadeddata', markReady);
  video?.addEventListener('canplay', markReady);
  prime();
  // Low Power Mode refuses muted autoplay too; a touch counts as permission
  window.addEventListener('touchstart', prime, { once: true, passive: true });

  video?.addEventListener('seeked', () => {
    if (video && target !== null && Math.abs(video.currentTime - target) > 0.04) video.currentTime = target;
  });
  video?.addEventListener('loadedmetadata', () => {
    if (vdur) vdur.textContent = fmt(duration());
  });

  // On desktop the headline grows to fill the space above the name box: the largest size at which
  // it fits the cell's width without breaking a word and the height left on the first screen.
  // Stacked (820px and below) it keeps the CSS size, which matches the case study titles.
  const hero = document.querySelector<HTMLElement>('.hx-hero');
  const strap = hero?.querySelector<HTMLElement>('.hx-strap');
  const h1 = strap?.querySelector<HTMLElement>('.hx-h1');
  const nameBox = strap?.querySelector<HTMLElement>('.hx-name');
  const cta = hero?.querySelector<HTMLElement>('.hx-cta');
  const desktop = matchMedia('(min-width: 821px)');
  const MIN_SIZE = 40;
  const MAX_SIZE = 200;
  function fitHeadline() {
    if (!hero || !strap || !h1 || !nameBox || !cta) return;
    h1.style.fontSize = '';
    h1.style.overflowWrap = '';
    if (!desktop.matches) return;
    const header = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0;
    const s = getComputedStyle(strap);
    const room = window.innerHeight - header - cta.offsetHeight - parseFloat(getComputedStyle(hero).rowGap || '0')
      - parseFloat(s.paddingTop) - parseFloat(s.paddingBottom) - parseFloat(s.rowGap || '0') - nameBox.offsetHeight;
    h1.style.overflowWrap = 'normal'; // so a word too wide for the cell shows up as overflow
    let lo = MIN_SIZE;
    let hi = MAX_SIZE;
    for (let k = 0; k < 14; k++) {
      const mid = (lo + hi) / 2;
      h1.style.fontSize = `${mid}px`;
      if (h1.scrollHeight <= room && h1.scrollWidth <= h1.clientWidth) lo = mid; else hi = mid;
    }
    h1.style.fontSize = `${Math.floor(lo)}px`;
  }
  fitHeadline();
  document.fonts?.ready.then(fitHeadline);
  let fitQueued = false;
  window.addEventListener('resize', () => {
    if (fitQueued) return;
    fitQueued = true;
    requestAnimationFrame(() => { fitQueued = false; fitHeadline(); });
  });

  const slideLinks = slidesCell?.querySelectorAll<HTMLAnchorElement>('[data-slink]') ?? [];

  function showSlide(i: number) {
    const n = slides.length;
    if (!n) return;
    i = ((i % n) + n) % n;
    if (i === currentSlide) return;
    currentSlide = i;
    slides.forEach((el, k) => { el.style.opacity = k === i ? '1' : '0'; });
    if (scap) scap.textContent = String(i + 1).padStart(2, '0');
    if (sname) sname.textContent = slides[i].dataset.title ?? '';
    slideLinks.forEach((a) => { a.href = slides[i].dataset.href ?? a.href; });
  }

  const fraction = (e: PointerEvent, el: HTMLElement) => {
    const r = el.getBoundingClientRect();
    return Math.min(0.9999, Math.max(0, (e.clientX - r.left) / r.width));
  };

  cell?.addEventListener('pointermove', (e) => seek(fraction(e, cell) * duration()));
  // The slideshow moves only with its arrows, and wraps round at either end
  slidesCell?.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
    btn.addEventListener('click', () => showSlide(currentSlide + Number(btn.dataset.step)));
  });

  let queued = false;
  window.addEventListener('scroll', () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const p = Math.min(1, window.scrollY / max);
      seek(p * duration());
    });
  }, { passive: true });
</script>
