---
// Section heading row: large uppercase heading with a small label on the right, ruled underneath.
interface Props {
  label?: string;
  level?: 'h1' | 'h2';
  onAccent?: boolean;
}
const { label, level = 'h2', onAccent = false } = Astro.props;
const Heading = level;
---
<div class:list={['section-head', { 'on-accent': onAccent }]}>
  <Heading class="section-heading"><slot /></Heading>
  {label && <span class="section-label">{label}</span>}
</div>

<style>
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    padding-bottom: 16px;
    border-bottom: var(--rule) solid var(--ink);
  }
  .section-head.on-accent { border-bottom-color: var(--on-accent); }
  .section-label {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
