---
// Lightbox for images and videos in a case study's write-up. A video figure (data-video on its button)
// plays here with the browser's controls, and stops when the lightbox closes or moves on. A YouTube figure
// (data-youtube) plays in YouTube's privacy-enhanced player (youtube-nocookie.com), loaded only on play. Every figure image is wrapped in a .cs-zoom button
// (lib/markdown-plugins.mjs); clicking one opens it larger in a modal, with its caption.
// The previous and next arrows (and the arrow keys) step through every image in the article, in order.
// Clicks are picked up on the document, so images in a protected article work once it is unlocked.
// Escape, the close button or a click outside the image closes it, and focus returns to the image
// that is showing.
---
<dialog id="lightbox" class="lb" aria-label="Image">
  <div class="lb-bar">
    <span class="lb-count label" aria-live="polite"></span>
    <button class="burger lb-close" type="button" aria-label="Close image"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12"></path></svg></button>
  </div>
  <div class="lb-stage">
    <button class="burger lb-nav lb-prev" type="button" aria-label="Previous image"><svg class="arr" viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H3M7 4 3 8l4 4"></path></svg></button>
    <figure class="lb-fig">
      <img class="lb-img" alt="" />
      <video class="lb-img lb-video" controls playsinline preload="none" hidden></video>
      <div class="lb-img lb-yt" hidden></div>
      <figcaption class="lb-cap" hidden></figcaption>
    </figure>
    <button class="burger lb-nav lb-next" type="button" aria-label="Next image"><svg class="arr" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></button>
  </div>
</dialog>

<style>
  .lb { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: clamp(16px, 2vw, 32px); border: 0; background: transparent; color: var(--ink); }
  .lb[open] { display: flex; flex-direction: column; gap: 16px; }
  .lb::backdrop { background: var(--bg); }
  .lb-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .arr { width: 16px; height: 16px; }
  .lb-nav:disabled { visibility: hidden; }
  /* Arrows either side of the image; on narrow screens they sit below it */
  .lb-stage { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: clamp(16px, 2vw, 32px); }
  .lb-fig { min-height: 0; height: 100%; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; }
  .lb-img { max-width: 100%; max-height: calc(100dvh - 160px); width: auto; height: auto; object-fit: contain; border: var(--rw) solid var(--ink); box-shadow: 8px 8px 0 var(--ink); background: var(--hl-bg); }
  .lb-yt { width: min(100%, calc((100dvh - 160px) * 16 / 9)); aspect-ratio: 16 / 9; background: var(--ink); }
  .lb-yt :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .lb-cap { margin: 0; padding: 8px 10px; background: var(--bg); border: var(--rw) solid var(--ink); font: 400 12px/1.4 var(--mono); letter-spacing: .02em; }
  .lb-cap[hidden], .lb-img[hidden] { display: none; }
  @media (max-width: 720px) {
    .lb-stage { grid-template-columns: 1fr 1fr; grid-template-rows: minmax(0, 1fr) auto; }
    .lb-fig { grid-column: 1 / -1; grid-row: 1; }
    .lb-prev { grid-row: 2; justify-self: start; } .lb-next { grid-row: 2; justify-self: end; }
    .lb-img { max-height: calc(100dvh - 230px); }
    .lb-yt { width: min(100%, calc((100dvh - 230px) * 16 / 9)); }
  }
  :global(html:has(#lightbox[open])) { overflow: hidden; }

  /* The figure image buttons in the write-up: ink edged, lifting on hover like the cards */
  :global(.cs-zoom) { position: relative; display: block; width: 100%; padding: 0; border: var(--rw) solid var(--ink); background: var(--hl-bg); overflow: hidden; cursor: zoom-in; transition: transform .12s ease, box-shadow .12s ease; }
  :global(.cs-zoom:hover) { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--ink); }
  :global(.cs-zoom--video) { cursor: pointer; }
  /* Video figures: a square play button over the poster */
  :global(.cs-play) { position: absolute; inset: 50% auto auto 50%; translate: -50% -50%; display: flex; align-items: center; justify-content: center; width: 72px; height: 72px; border: var(--rw) solid var(--ink); background: var(--bg); color: var(--ink); }
  :global(.cs-play svg) { margin-left: 4px; }
  :global(.cs-zoom--video:hover .cs-play) { background: var(--hl-bg); color: var(--hl-ink); }
  @media (prefers-reduced-motion: reduce) { :global(.cs-zoom) { transition: none; } }
</style>

<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = box?.querySelector<HTMLImageElement>('img.lb-img');
  const video = box?.querySelector<HTMLVideoElement>('.lb-video');
  const yt = box?.querySelector<HTMLElement>('.lb-yt');
  const cap = box?.querySelector<HTMLElement>('.lb-cap');
  const count = box?.querySelector<HTMLElement>('.lb-count');
  const prev = box?.querySelector<HTMLButtonElement>('.lb-prev');
  const next = box?.querySelector<HTMLButtonElement>('.lb-next');
  let items: HTMLButtonElement[] = [];
  let index = 0;

  function stopVideo() {
    // Removing the player stops a YouTube video
    if (yt && !yt.hidden) { yt.replaceChildren(); yt.hidden = true; }
    if (!video || video.hidden) return;
    video.pause();
    video.removeAttribute('src');
    video.load();
    video.hidden = true;
  }

  function show(i: number) {
    const btn = items[i];
    const source = btn?.querySelector('img');
    if (!img || !video || !yt || !cap || !count || !prev || !next || !source) return;
    index = i;
    stopVideo();
    const clip = btn.dataset.video;
    const ytId = btn.dataset.youtube;
    img.hidden = !!(clip || ytId);
    if (ytId) {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(ytId)}?autoplay=1&rel=0&playsinline=1`;
      frame.title = source.alt || 'YouTube video';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      yt.replaceChildren(frame);
      yt.hidden = false;
    } else if (clip) {
      video.poster = source.currentSrc || source.src;
      video.src = clip;
      video.setAttribute('aria-label', source.alt);
      video.hidden = false;
      video.play().catch(() => { /* autoplay refused: the controls are there */ });
    } else {
      img.src = source.currentSrc || source.src;
      img.alt = source.alt;
    }
    const caption = btn.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
    cap.textContent = caption;
    cap.hidden = !caption;
    count.textContent = items.length > 1 ? `${i + 1} / ${items.length}` : '';
    prev.disabled = i === 0;
    next.disabled = i === items.length - 1;
    // Keep focus on a visible control when an arrow hides at either end
    if (document.activeElement instanceof HTMLButtonElement && document.activeElement.disabled) {
      (i === 0 ? next : prev).focus();
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLButtonElement>('.cs-zoom');
    if (!box || !btn) return;
    // Read the list on every open, so images in an article unlocked after page load are included
    items = [...document.querySelectorAll<HTMLButtonElement>('.cs-zoom')];
    show(items.indexOf(btn));
    box.showModal();
    box.querySelector<HTMLButtonElement>('.lb-close')?.focus();
  });

  prev?.addEventListener('click', () => index > 0 && show(index - 1));
  next?.addEventListener('click', () => index < items.length - 1 && show(index + 1));
  box?.addEventListener('keydown', (e) => {
    // Inside the video the arrow keys seek, as usual
    if ((e.target as Element).closest('video')) return;
    if (e.key === 'ArrowLeft' && index > 0) { e.preventDefault(); show(index - 1); }
    if (e.key === 'ArrowRight' && index < items.length - 1) { e.preventDefault(); show(index + 1); }
  });

  box?.querySelector('.lb-close')?.addEventListener('click', () => box.close());
  // A click anywhere but the image, caption or a button closes it
  box?.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.lb-img, .lb-video, .lb-yt, .lb-cap, button')) box.close();
  });
  // Focus goes back to the image that was showing, so the reader keeps their place in the article
  box?.addEventListener('close', () => {
    stopVideo();
    items[index]?.focus({ preventScroll: false });
    items = [];
  });
</script>
