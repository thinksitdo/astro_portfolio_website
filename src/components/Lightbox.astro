---
// Lightbox for images in a case study's write-up. Every figure image is wrapped in a .cs-zoom button
// (lib/markdown-plugins.mjs); clicking one opens it larger in a modal, with its caption.
// Clicks are picked up on the document, so images in a protected article work once it is unlocked.
// Escape, the close button or a click outside the image closes it, and focus returns to the image.
---
<dialog id="lightbox" class="lb" aria-label="Image">
  <div class="lb-bar">
    <button class="icon-btn lb-close" type="button" aria-label="Close image">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M2 2L18 18M18 2L2 18" stroke="currentColor" stroke-width="3"></path></svg>
    </button>
  </div>
  <figure class="lb-fig">
    <img class="lb-img" alt="" />
    <figcaption class="lb-cap" hidden></figcaption>
  </figure>
</dialog>

<style>
  .lb {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 3vw, 40px);
    border: 0;
    background: transparent;
    color: var(--ink);
  }
  .lb[open] { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .lb::backdrop { background: var(--bg); }
  .lb-bar { align-self: stretch; display: flex; justify-content: flex-end; }
  .lb-close { background: var(--bg); }
  .lb-fig {
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .lb-img {
    max-width: 100%;
    max-height: calc(100dvh - 160px);
    width: auto;
    height: auto;
    object-fit: contain;
    border: var(--rule) solid var(--ink);
    box-shadow: 10px 10px 0 var(--ink);
    background: var(--thumb);
  }
  .lb-cap {
    margin: 0;
    padding: 6px 10px;
    background: var(--bg);
    border: var(--rule-thin) solid var(--ink);
    font: 400 12px var(--font-mono);
    letter-spacing: 0.02em;
  }
  .lb-cap[hidden] { display: none; }
  :global(html:has(#lightbox[open])) { overflow: hidden; }

  /* The figure image buttons in the write-up: no button look, the arrow cursor and a pink focus ring */
  :global(.cs-zoom) {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: var(--cursor-link);
  }
  :global(.cs-zoom:focus-visible) { outline: 3px solid var(--ink); outline-offset: 3px; }
</style>

<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = box?.querySelector<HTMLImageElement>('.lb-img');
  const cap = box?.querySelector<HTMLElement>('.lb-cap');
  let opener: HTMLElement | null = null;

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLButtonElement>('.cs-zoom');
    const source = btn?.querySelector('img');
    if (!box || !img || !cap || !btn || !source) return;
    opener = btn;
    img.src = source.currentSrc || source.src;
    img.alt = source.alt;
    const caption = btn.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
    cap.textContent = caption;
    cap.hidden = !caption;
    box.showModal();
    box.querySelector<HTMLButtonElement>('.lb-close')?.focus();
  });

  box?.querySelector('.lb-close')?.addEventListener('click', () => box.close());
  // A click anywhere but the image or caption closes it
  box?.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.lb-img, .lb-cap, .lb-close')) box.close();
  });
  box?.addEventListener('close', () => {
    opener?.focus();
    opener = null;
  });
</script>
