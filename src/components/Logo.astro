---
// The logo link used in the header and the menu. The image inverts in dark mode.
---
<a class="h-logo" href="/" aria-label="Scott Robinson, home">
  <img src="/media/sr-logo.png" alt="" width="553" height="394" />
</a>

<style>
  .h-logo {
    display: flex;
    align-items: center;
    min-height: 72px;
    padding: 12px 0;
    text-decoration: none;
  }
  img { height: 44px; width: auto; }
  :global(:root[data-theme='dark']) img { filter: invert(1); }
</style>
