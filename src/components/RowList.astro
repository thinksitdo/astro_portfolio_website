---
// Rows of cases, publications or projects, with optional filter chips and a thumbnail that follows the
// cursor. Used on the homepage (cases, no filters) and the Cases, Publications and Academic & Artistic pages.
// Case studies, projects and publications are never mixed in one list.
import { isTodo } from '../lib/content';

export interface Row {
  href: string;
  title: string;
  summary: string;
  /** Filter keys this row belongs to */
  tags: string[];
  /** Second column */
  col3: string;
  /** The rest: one part (the year) or two (a third column, then the year). May contain TODO markers */
  col4: string[];
  thumbnail: string | null;
}
interface Props {
  rows: Row[];
  /** Filter chips; leave out for none */
  filters?: string[];
  /** Column labels: three (title, type, year) or four (title, two meta columns, year) */
  headings: string[];
  filterLabel?: string;
  /** Show a "Thumbnail · title" placeholder for rows without a thumbnail (false: no popover) */
  thumbPlaceholders?: boolean;
  /** Kept for older call sites; the redesign has no numbered rows */
  numbered?: boolean;
  fourthUpper?: boolean;
}
const { rows, filters = [], headings, filterLabel = 'Filter', thumbPlaceholders = true } = Astro.props;
const three = headings.length === 3;
const [hT, hR, hC, hY] = three ? [headings[0], headings[1], '', headings[2]] : headings;
const cell = (v: string) => (isTodo(v) ? 'TODO' : v);
---
<div class:list={['row-list', 'sub', { 'cols-3': three }]} data-row-list data-thumb-placeholders={thumbPlaceholders ? 'true' : 'false'}>
  {filters.length > 0 && (
    <div class="filters" role="group" aria-label={filterLabel}>
      {filters.map((f, i) => (
        <button class="chip" type="button" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>{f}</button>
      ))}
    </div>
  )}
  <div class="rows hov sub">
    <div class="heads sub" aria-hidden="true">
      <span class="c-t">{hT}</span><span class="c-r">{hR}</span>{!three && <span class="c-c">{hC}</span>}<span class="c-y">{hY}</span>
    </div>
    {rows.map((r) => {
      const year = r.col4[r.col4.length - 1] ?? '';
      const third = r.col4.length > 1 ? r.col4.slice(0, -1).join(' · ') : '';
      return (
        <a class="row sub" href={r.href} data-tags={JSON.stringify(r.tags)} data-thumb={r.thumbnail ?? ''} data-title={r.title}>
          <span class="c-t"><span class="t">{r.title}</span>{r.summary && <span class="sum">{r.summary}</span>}</span>
          <span class="c-r m">{r.col3}</span>
          {!three && <span class="c-c m">{cell(third)}</span>}
          <span class="c-y m">{isTodo(year) ? <span class="todo">TODO</span> : year}</span>
        </a>
      );
    })}
  </div>
  <div class="pop" aria-hidden="true"><img alt="" hidden /><span class="pop-text" hidden></span></div>
</div>

<style>
  .filters { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(24px, 2.4vw, 40px); }
  .filters + .rows { margin-top: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-row-list]').forEach((list) => {
    const chips = Array.from(list.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const rows = Array.from(list.querySelectorAll<HTMLAnchorElement>('a.row'));
    const pop = list.querySelector<HTMLElement>('.pop')!;
    const img = pop.querySelector('img')!;
    const text = pop.querySelector<HTMLElement>('.pop-text')!;
    const placeholders = list.dataset.thumbPlaceholders !== 'false';

    // Filters
    chips.forEach((chip, i) => chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
      rows.forEach((row) => { row.hidden = i > 0 && !JSON.parse(row.dataset.tags || '[]').includes(chip.dataset.filter); });
      close();
    }));

    // The thumbnail sits up and to the right of the cursor, and flips left near the edge. It waits until
    // the cursor rests on a row (350ms), so sweeping down the list doesn't flash every image; a few pixels
    // of tremor don't restart the wait. Once open, the next row swaps straight away. It closes when the
    // cursor leaves the list
    const REST_MS = 350, JITTER = 3;
    let open = false, current: HTMLAnchorElement | null = null, timer = 0, restX = 0, restY = 0;
    let last: MouseEvent | null = null;
    const place = (e: MouseEvent) => {
      const w = pop.offsetWidth, h = pop.offsetHeight;
      const x = e.clientX + 18 + w > innerWidth ? e.clientX - w - 18 : e.clientX + 18;
      pop.style.translate = `${x}px ${Math.max(8, e.clientY - h - 12)}px`;
    };
    const show = (row: HTMLAnchorElement) => {
      const src = row.dataset.thumb;
      if (!src && !placeholders) { pop.classList.remove('on'); return false; }
      img.hidden = !src;
      text.hidden = !!src;
      if (src) img.src = src; else text.textContent = `Thumbnail · ${row.dataset.title}`;
      pop.classList.add('on');
      return true;
    };
    const cancel = () => { clearTimeout(timer); timer = 0; };
    const close = () => { cancel(); open = false; current = null; pop.classList.remove('on'); };
    const wait = (e: MouseEvent) => {
      cancel();
      restX = e.clientX; restY = e.clientY;
      timer = window.setTimeout(() => { timer = 0; if (current && show(current)) { open = true; place(last || e); } }, REST_MS);
    };
    const area = list.querySelector<HTMLElement>('.rows')!;
    area.addEventListener('mousemove', (e) => {
      last = e;
      if (open) { place(e); return; }
      if (!current) return;
      if (timer && Math.abs(e.clientX - restX) <= JITTER && Math.abs(e.clientY - restY) <= JITTER) return;
      wait(e);
    });
    area.addEventListener('mouseleave', close);
    rows.forEach((row) => {
      row.addEventListener('mouseenter', (e) => {
        current = row; last = e;
        if (open) { if (!show(row)) open = false; place(e); } else wait(e);
      });
      row.addEventListener('mouseleave', () => { if (current === row) current = null; cancel(); });
    });
  });
</script>
