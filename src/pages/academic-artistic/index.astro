---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListHero from '../../components/ListHero.astro';
import RowList from '../../components/RowList.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { getProjects, projectRows } from '../../lib/content';

const projects = await getProjects();
---
<BaseLayout title="Academic & Artistic" description="TODO" bodyFont="inter">
  <ListHero title="Academic & Artistic" size="lg">
    A selection of my research projects, collaborations and design encounters. For the full picture of my research, see the <a class="l-mark" href="/thesis/">thesis page</a>.
  </ListHero>
  <section class="list-section">
    <div class="wrap">
      <RowList
        rows={projectRows(projects)}
        filters={['All', 'Academic', 'Artistic']}
        headings={['No.', 'Project', 'Type', 'Role · Year']}
      />
    </div>
  </section>
  <ContactBlock />
</BaseLayout>

<style>
  .list-section { border-bottom: var(--rule) solid var(--ink); }
  .list-section .wrap { padding-block: var(--step-32-64); }
</style>
