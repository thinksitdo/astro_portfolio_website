---
// Thesis page. The markup is carried across from design/reference/thesis.dc.html; its inline styles use
// the same tokens as the rest of the site (var(--ink), var(--bg), var(--muted), var(--thumb), var(--accent)).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
---
<BaseLayout
  title="Bodies (in)form"
  description="Bodies (in)form: Reconceptualising Embodied Design as Intercorporeal Encounters"
  bodyFont="inter"
>
<section style="border-bottom: 3px solid var(--ink)"><div style="max-width: 1320px; margin: 0 auto; padding-left: var(--step-16-32); padding-right: var(--step-16-32); padding-top: var(--step-64-128); padding-bottom: var(--step-32-64)">
<h1 style="margin: 0; max-width: 1100px; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: clamp(40px, 6vw, 96px); --lh: 1; letter-spacing: -0.02em">Bodies (in)form: Reconceptualising Embodied Design as Intercorporeal Encounters</h1>
<div class="facts" style="display: flex; flex-wrap: wrap; gap: 3px; background: var(--ink); border: 3px solid var(--ink); margin-top: 64px"><div style="background: var(--bg); padding: 16px 32px; display: flex; flex-direction: column; gap: 8px"><span style="font: 500 13px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em">Degree</span><span style="font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 700; font-size: 22px; --lh: 1.2">Practice-based PhD</span></div><div style="background: var(--bg); padding: 16px 32px; display: flex; flex-direction: column; gap: 8px"><span style="font: 500 13px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em">Institution</span><span style="font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 700; font-size: 22px; --lh: 1.2">Goldsmiths, University of London</span></div><div style="background: var(--bg); padding: 16px 32px; display: flex; flex-direction: column; gap: 8px"><span style="font: 500 13px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em">Funding</span><span style="font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 700; font-size: 22px; --lh: 1.2">AHRC</span></div><div style="background: var(--bg); padding: 16px 32px; display: flex; flex-direction: column; gap: 8px"><span style="font: 500 13px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em">Completed</span><span style="font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 700; font-size: 22px; --lh: 1.2">April 2026</span></div><a class="b-tileP" href="https://research.gold.ac.uk/id/eprint/40427/" style="background: var(--accent); color: #0A0A0A; padding: 16px 32px; display: flex; flex-direction: column; justify-content: space-between; gap: 16px; text-decoration: none"><span style="font: 500 13px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em">→</span><span style="font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 26px; --lh: 1">Download full thesis</span></a></div>
</div></section><section style="border-bottom: 3px solid var(--ink)"><div style="max-width: 1320px; margin: 0 auto; padding-left: var(--step-16-32); padding-right: var(--step-16-32); padding-top: 32px; padding-bottom: 32px"><img src="/media/thesis-cover-spread.jpg" width="2500" height="1154" alt="The thesis Bodies (in)form, its black cover beside an open spread from Chapter 3 showing the public installation at Goldsmiths" style="display: block; width: 100%; height: auto; border: 3px solid var(--ink); box-sizing: border-box"></div></section><section style="border-bottom: 3px solid var(--ink)"><div style="max-width: 1320px; margin: 0 auto; padding-left: var(--step-16-32); padding-right: var(--step-16-32); padding-top: var(--step-32-64); padding-bottom: var(--step-32-64)"><blockquote style="margin: 0; max-width: 1080px"><p style="margin: 0; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 700; font-size: clamp(32px, 4.4vw, 68px); --lh: 1.02; letter-spacing: -0.025em">“Being embodied is never a private affair but is always already mediated… with other human and nonhuman bodies.”</p><footer style="margin-top: 32px; font: 500 13px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em">Gail Weiss, <cite style="font-style: italic; text-transform: none">Body Images: Embodiment as Intercorporeality</cite>, 1999, p. 5</footer></blockquote></div></section><section style="border-bottom: 3px solid var(--ink)"><div style="max-width: 1320px; margin: 0 auto; padding-left: var(--step-16-32); padding-right: var(--step-16-32); padding-top: var(--step-32-64); padding-bottom: var(--step-32-64)"><div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 32px; padding-bottom: 16px; border-bottom: 3px solid var(--ink)"><h2 style="margin: 0; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 900; font-size: clamp(44px, 6.4vw, 104px); --lh: 0.88; letter-spacing: -0.03em">Abstract</h2></div><div style="display: flex; flex-wrap: wrap; gap: 32px 64px; margin-top: 32px"><div style="flex: 1 1 220px; max-width: 300px"><a class="b-pri" href="https://research.gold.ac.uk/id/eprint/40427/" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 16px; border: 2px solid var(--ink); background: var(--accent); color: #0A0A0A; font: 600 13px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none">Download full thesis →</a></div><div style="flex: 999 1 560px; min-width: 0; max-width: 820px"><p style="margin: 0 0 16px"><em>What does it mean to become an embodied designer—or to be an embodied designer in a continual state of becoming?</em> This practice-based PhD responds to the growing shift in design towards approaches that emphasise the use of bodies—both designers’ and participants’—to work through design problems. Drawing on feminist post-phenomenology, particularly relational accounts of embodiment in the work of Gail Weiss (1999) and Sara Ahmed (2000), I conduct auto-ethnographic research in collaboration with somatic practitioners, including performer trainers and indoor climbing routesetters. I propose and test <em>encounters</em> as a strong concept for expanding and articulating embodied design practices, re-envisioning design activities as <em>encounters</em>: intercorporeal sites of practice dynamically, socially, culturally, spatially, and temporally constituted in, through, and alongside participating bodies.</p><p style="margin: 0 0 16px">Historically, design has relied on phenomenology and postmodernism to conceptualise the body, risking generalisation and the neutralisation of embodied subjectivity. Conventional ideation methods such as scenarios, storyboards, and experience mapping also limit the agency and creativity of the bodies involved. By contrast, somaesthetic and feminist approaches centralise lived experience and render bodies generative material in design practice. While the term <em>encounter</em> appears in design literature to evoke the richness of lived experience, it remains under-defined. Responding to this gap, I ask how the concept of <em>encounters</em> might enable embodied design to account for the relationality and in-betweenness of embodiment across the bodies of designers and participants; what embodied design can learn about bodies from post-phenomenological feminist theory; how designers can acknowledge and negotiate their own embodied subjectivity; and what performer training, routesetting, and the concept of the drift (Smith 2010) can teach designers about tuning into and working with our bodies and the bodies of others.</p><p style="margin: 0 0 16px">These questions are pursued through two practice projects: <em>Stepping: With Performer Trainers</em>, a collaboration with Dr Göze Saner exploring performer training without physical co-presence; and <em>Climbing: With Routesetters</em>, a first-person study of routesetting at Mile End Wall in East London. Both practices, under-researched in the field of design, exemplify body-first, relational forms of somatic expertise through which <em>Design Encounters</em> are realised.</p></div></div></div></section><section style="border-bottom: 3px solid var(--ink)"><div style="max-width: 1320px; margin: 0 auto; padding-left: var(--step-16-32); padding-right: var(--step-16-32); padding-top: 32px; padding-bottom: 32px"><img src="/media/thesis-spread-climbing.jpg" width="1655" height="1154" loading="lazy" alt="Open spread from Chapter 4, Climbing with Routesetters, with photographs of routes at Mile End climbing wall" style="display: block; width: 100%; height: auto; border: 3px solid var(--ink); box-sizing: border-box"></div></section><section style="border-bottom: 3px solid var(--ink)"><div style="max-width: 1320px; margin: 0 auto; padding-left: var(--step-16-32); padding-right: var(--step-16-32); padding-top: var(--step-32-64); padding-bottom: var(--step-32-64)"><div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 32px; padding-bottom: 16px; border-bottom: 3px solid var(--ink)"><h2 style="margin: 0; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 900; font-size: clamp(44px, 6.4vw, 104px); --lh: 0.88; letter-spacing: -0.03em">Thesis outline</h2></div><ol style="margin: 0; padding: 0; list-style: none"><li style="display: flex; flex-wrap: wrap; gap: 16px 32px; padding: 32px 0; border-bottom: 2px solid var(--ink)"><span style="flex: 0 0 110px; font: 600 14px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em; padding-top: 8px">Chapter 1</span><div style="flex: 1 1 260px; max-width: 340px"><h3 style="margin: 0; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 32px; --lh: 1.1">Introduction</h3></div><div style="flex: 999 1 480px; min-width: 0; max-width: 780px"><p style="margin: 0; font-size: 15px; --lh: 1.7">In <em>Chapter One</em>, I introduce my research and my research questions. I situate my research within the fields of embodied and somaesthetic design. Against Paul Dourish’s outward-facing account of embodiment as situated interaction, and Höök’s inward-facing somaesthetic approach, I identify a gap in how design could orientate towards the body and the bodies of others, proposing the concept of encounter as an alternative. Using the metaphor of the mongrel I describe my cross-disciplinary practice grounded in experience design. I describe my research methodology emerging from a series of early embodied experiments drawing together a range of embodied and reflective approaches; walking and drifting as spatial practices; embodied ideation; multimodal documentation; and textural reflexivity as a mode of critical reflection. I introduce ideas and bodily practices that are foundational to the practice research that follows. These include the use of theatre studios, Wizard of Oz and lo-fi technology to create responsive environments for prototyping, and indoor climbing as a subject of research.</p></div></li><li style="display: flex; flex-wrap: wrap; gap: 16px 32px; padding: 32px 0; border-bottom: 2px solid var(--ink)"><span style="flex: 0 0 110px; font: 600 14px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em; padding-top: 8px">Chapter 2</span><div style="flex: 1 1 260px; max-width: 340px"><h3 style="margin: 0; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 32px; --lh: 1.1">Design (as) Encounters</h3></div><div style="flex: 999 1 480px; min-width: 0; max-width: 780px"><p style="margin: 0; font-size: 15px; --lh: 1.7">In <em>Chapter Two</em>, I look at how experience is understood as both phenomenon and material within the field of experience design, highlighting how design draws from other fields to achieve this. I challenge the somewhat neutral or absent representation of bodies in these theories, particularly phenomenology. I also question whether interaction or experience is an appropriate container for my own understanding of how I use my body and the bodies of others in my own practice. Drawing on post-phenomenological feminist theory, particularly Sara Ahmed’s concepts of <em>orientation</em> and <em>strange encounters</em> and Gail Weiss’ <em>intercorporeality</em> I define and inform a set of visceral embodied metaphors to challenge biases to which neutralised and universalised representations of the body in design are susceptible. I propose encounters as more appropriate for my practice, presenting it as a strong concept (Höök and Löwgren 2012) and conceptual frame for this research. Finally, I contextualise my own research in relation to other embodied designers and researchers looking at early examples of embodied ideation through to practitioners drawing on somatic and feminist design approaches.</p></div></li><li style="display: flex; flex-wrap: wrap; gap: 16px 32px; padding: 32px 0; border-bottom: 2px solid var(--ink)"><span style="flex: 0 0 110px; font: 600 14px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em; padding-top: 8px">Chapter 3</span><div style="flex: 1 1 260px; max-width: 340px"><h3 style="margin: 0; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 32px; --lh: 1.1">Stepping with Theatre Practitioners</h3></div><div style="flex: 999 1 480px; min-width: 0; max-width: 780px"><p style="margin: 0; font-size: 15px; --lh: 1.7">In <em>Chapter Three</em>, I discuss and reflect on an embodied design project in collaboration with theatre practitioner and academic Dr Göze Saner, where we explored alternative approaches to performer training that did not require or rely on the presence of a tutor. I discuss the project and our collaborative process to further my understanding of ‘encounters’ as a framework for embodied design and to deepen my view of bodies as sites and generative materials of design practice. I reflect on how bodies can be used to ideate intercorporeally in ways that go beyond scripted scenarios, through encounters that accept them as monstrous, amplified and imaginary, and reflect on the embodied function and impact of various technologies, tools and roles.</p><div style="margin-top: 16px"><a class="b-sec" href="/academic-artistic/stepping-with-theatre-practitioners/" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 16px; border: 2px solid var(--ink); color: var(--ink); font: 600 13px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none">View this project →</a></div></div></li><li style="display: flex; flex-wrap: wrap; gap: 16px 32px; padding: 32px 0; border-bottom: 2px solid var(--ink)"><span style="flex: 0 0 110px; font: 600 14px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em; padding-top: 8px">Chapter 4</span><div style="flex: 1 1 260px; max-width: 340px"><h3 style="margin: 0; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 32px; --lh: 1.1">Climbing with Routesetters</h3></div><div style="flex: 999 1 480px; min-width: 0; max-width: 780px"><p style="margin: 0; font-size: 15px; --lh: 1.7">In <em>Chapter Four</em>, I conduct a first-person study of routesetting for indoor climbing as an embodied and somatic practice from three unique and complementary positions. Working with the team at Mile End Climbing Wall, I <em>observe</em> professional routesetters as they use their skills to design climbing problems for other bodies to solve. I <em>listen</em> to the amplified sounds of my own body, and groups of other climbers, as we climb the problems we have been set. Finally, as a routesetter-in-training, I do routesetting myself. Through these positionalities I investigate the effectiveness of encounters and their characteristics as a conceptual frame <em>within</em> and reflecting <em>on</em> practice. I explore how encounters and their principal characteristic can be used to surface new ways of understanding routesetting as an embodied practice. I explore what routesetting could teach embodied designers about tuning into and working with our own bodies and other bodies.</p><div style="margin-top: 16px"><a class="b-sec" href="/academic-artistic/climbing-with-routesetters/" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 16px; border: 2px solid var(--ink); color: var(--ink); font: 600 13px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none">View this project →</a></div></div></li><li style="display: flex; flex-wrap: wrap; gap: 16px 32px; padding: 32px 0; border-bottom: 2px solid var(--ink)"><span style="flex: 0 0 110px; font: 600 14px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em; padding-top: 8px">Chapter 5</span><div style="flex: 1 1 260px; max-width: 340px"><h3 style="margin: 0; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 32px; --lh: 1.1">Conclusion</h3></div><div style="flex: 999 1 480px; min-width: 0; max-width: 780px"><p style="margin: 0; font-size: 15px; --lh: 1.7">In <em>Chapter Five</em>, I summarise the findings of my research and reflect on the contribution of encounter as both a strong concept and conceptual frame for embodied design. I draw on my critical review of design theory and practice, together with my two practice-based research projects to demonstrate how encounters offer an alternative container to challenge neutral, universal, or overly abstract accounts of the body in design. I emphasise how encounters foreground subjectivity, intercorporeality, and the unpredictability of embodied practice, rendering bodies and the space between bodies as generative sites of embodied design practice. I then return to my research questions and reflect on where I stand in relation to the central question of this research: what it means to be an embodied designer in a state of becoming. Finally, I consider the implications of encounters for embodied design research more broadly, reflecting on how the concept might be taken up in other practices and contexts, before concluding the thesis with a manifesto for designing with encounters.</p></div></li></ol></div></section><section style="border-bottom: 3px solid var(--ink)"><div style="max-width: 1320px; margin: 0 auto; padding-left: var(--step-16-32); padding-right: var(--step-16-32); padding-top: 32px; padding-bottom: 32px"><div role="img" aria-label="Image placeholder, metaphor chapter spread (thesis-spread-metaphor.jpg)" style="aspect-ratio: 16 / 7; background: var(--thumb); border: 3px solid var(--ink); display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px; box-sizing: border-box; font: 500 12px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em">Image · metaphor chapter spread (thesis-spread-metaphor.jpg)</div></div></section><section style="border-bottom: 3px solid var(--ink)"><div style="max-width: 1320px; margin: 0 auto; padding-left: var(--step-16-32); padding-right: var(--step-16-32); padding-top: var(--step-32-64); padding-bottom: var(--step-32-64)"><div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 32px; padding-bottom: 16px; border-bottom: 3px solid var(--ink)"><h2 style="margin: 0; font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 900; font-size: clamp(44px, 6.4vw, 104px); --lh: 0.88; letter-spacing: -0.03em">Related projects</h2></div><ol style="margin: 0; padding: 0; list-style: none"><li style="border-bottom: 2px solid var(--ink)"><a class="l-row" href="/academic-artistic/stepping-with-theatre-practitioners/" style="display: flex; flex-wrap: wrap; gap: 16px 32px; padding: 32px 8px; text-decoration: none; color: var(--ink)"><span style="flex: 0 0 48px; font: 600 14px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; padding-top: 8px">01</span><span style="flex: 999 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 8px"><span style="font: 500 12px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em">Research · 2016</span><span style="font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 30px; --lh: 1.1">Stepping: With Theatre Practitioners</span><span style="font-size: 15px; --lh: 1.6; max-width: 640px">This research project formed the third chapter of my doctoral thesis, where I collaborate with Dr Göze Saner, to design new approaches to performer…</span></span><span style="flex: 1 1 260px; display: flex; flex-direction: column; gap: 8px; padding-top: 8px"><span style="display: flex; flex-direction: column"><span style="font: 600 11px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.06em">Role</span><span style="font-size: 14px">Researcher</span></span><span style="display: flex; flex-direction: column"><span style="font: 600 11px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.06em">Collaborators</span><span style="font-size: 14px">Dr Göze Saner</span></span><span style="display: flex; flex-direction: column"><span style="font: 600 11px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.06em">Institution</span><span style="font-size: 14px">Goldsmiths, UoL</span></span></span><span aria-hidden="true" style="font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 32px; --lh: 1">→</span></a></li><li style="border-bottom: 2px solid var(--ink)"><a class="l-row" href="/academic-artistic/climbing-with-routesetters/" style="display: flex; flex-wrap: wrap; gap: 16px 32px; padding: 32px 8px; text-decoration: none; color: var(--ink)"><span style="flex: 0 0 48px; font: 600 14px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; padding-top: 8px">02</span><span style="flex: 999 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 8px"><span style="font: 500 12px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.04em">Research · 2024</span><span style="font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 30px; --lh: 1.1">Climbing: With Routesetters</span><span style="font-size: 15px; --lh: 1.6; max-width: 640px">This research project formed the fourth chapter of my doctoral thesis where I conduct a first-person study of the embodied practice of routesetting to…</span></span><span style="flex: 1 1 260px; display: flex; flex-direction: column; gap: 8px; padding-top: 8px"><span style="display: flex; flex-direction: column"><span style="font: 600 11px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.06em">Role</span><span style="font-size: 14px">Researcher</span></span><span style="display: flex; flex-direction: column"><span style="font: 600 11px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.06em">Collaborators</span><span style="font-size: 14px">Mile End Wall and Staff</span></span><span style="display: flex; flex-direction: column"><span style="font: 600 11px 'JetBrains Mono', ui-monospace, Menlo, monospace; --lh: 1.3; text-transform: uppercase; letter-spacing: 0.06em">Institution</span><span style="font-size: 14px">Goldsmiths, UoL</span></span></span><span aria-hidden="true" style="font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif; font-weight: 800; font-size: 32px; --lh: 1">→</span></a></li></ol></div></section>
