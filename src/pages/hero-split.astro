---
// Preview of the split hero layout, to compare with the homepage. Kept out of search results
// and the sitemap (lib/noindex.mjs). To use it on the homepage, pass layout="split" to <Hero />.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---
<BaseLayout title="Hero preview · split" description="Preview of the split hero layout.">
  <Hero layout="split" />
  <section id="work" class="section"><div class="wrap"><p>Preview of the split hero. The rest of the homepage is at <a class="l-mark" href="/">/</a>.</p></div></section>
  <section id="contact" class="section"><div class="wrap"><p>Get in touch target.</p></div></section>
</BaseLayout>
