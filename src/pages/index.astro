---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import RowList from '../components/RowList.astro';
import { caseFilters, caseRows, getCases } from '../lib/content';

const homeCases = (await getCases()).slice(0, 6);

const questions = [
  { n: '01', title: 'What is actually happening?', body: 'I use research to understand how people work, what they need, where things break down, and the organisational and technical context around them.', methods: 'Interviews · Observation · Workshops · Stakeholder engagement · Qualitative research · Experience mapping · Information architecture · Data evaluation' },
  { n: '02', title: 'What have we learned, and where is the opportunity?', body: 'I make sense of what we’ve learned, identify where meaningful change is possible, and turn evidence into opportunities, propositions and product direction.', methods: 'Synthesis · Relationship mapping · Product discovery · Proposition development · Product vision · Product strategy' },
  { n: '03', title: 'What might the answer look like?', body: 'I make things to explore ideas and answer questions, choosing the level of fidelity according to what we need to learn — from maps and staged experiences to prototypes and working software.', methods: 'Concept development · Embodied ideation · Wizard of Oz · Prototyping · AI-assisted prototyping' },
  { n: '04', title: 'Are we right?', body: 'I put ideas in front of people to understand what works, what doesn’t, and what we need to learn next.', methods: 'Usability testing · Remote testing · Prototype evaluation · Iteration · Product feedback · Market evidence' },
];

// img is null where Scott still has to supply the picture; the placeholder text names what goes there
const making = [
  { title: 'Mapping complex relationships', img: '/media/ngo-experience-map.jpg', placeholder: 'NGO mapping', body: 'Bringing interviews and workshops together into a form that allowed relationships between people, processes, data and digital services to be seen and questioned.' },
  { title: 'Staging an encounter', img: null, placeholder: 'Staging an encounter', body: 'Sometimes the thing being investigated is experiential. Staging an experience makes it possible to encounter and question something before deciding what should be built.' },
  { title: 'Making an idea testable', img: null, placeholder: 'Sketch', body: 'From sketches and interactive prototypes to working technology, giving an idea form creates something that can be experienced and questioned.' },
  { title: 'Building to investigate', img: null, placeholder: 'Citations React interface', body: 'AI-assisted development lets me take those questions into functional React interfaces, where encounters can be experienced and tested rather than imagined.' },
];

const research = [
  { title: 'Thesis', href: '/thesis/', body: 'I completed my AHRC-funded thesis at Goldsmiths, University of London, April 2026.' },
  { title: 'Publications', href: '/publications/', body: 'Read my research published by Bloomsbury, Taylor & Francis and Goldsmiths.' },
];
---
<BaseLayout
  title="Scott Robinson"
  description="I research encounters between people and technology, to better designed products."
>
  <Hero />

  <section id="about" class="section">
    <div class="wrap">
      <SectionHead>In short</SectionHead>
      <div class="split">
        <div class="split-main">
          <p class="lead">Designer, researcher and product strategist with 25+ years’ experience and a practice-based PhD.</p>
          <p class="muted intro">I help organisations understand people and products, find where meaningful change is possible, and turn that into product vision, strategy and features. Most recently, I spent seven years at an AI fintech startup, where I led research, product strategy and UX for a research platform used by investment professionals in a heavily regulated industry. <a class="l-mark cv" href="#contact">CV available on request</a></p>
        </div>
        <div class="box-grid facts">
          <div class="fact">
            <h3 class="fact-h">Specialisms</h3>
            <ul class="fact-list">
              <li>User Research</li>
              <li>UX Design</li>
              <li>Product Design and Strategy</li>
              <li>Human–AI Decision-Making</li>
            </ul>
          </div>
          <div class="fact">
            <h3 class="fact-h">Location</h3>
            <p class="fact-list">London, UK · Remote</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="focus" class="section focus pk">
    <div class="wrap">
      <SectionHead onAccent>Current focus</SectionHead>
      <div class="split">
        <div class="focus-a">
          <p class="focus-title">Human + AI decision-making</p>
          <p class="focus-sub">AI is both something I investigate and something that is changing how I investigate and make.</p>
        </div>
        <div class="focus-b">
          <p>My recent work explores AI from both sides of the design process. I research how people work with increasingly capable AI — how they interrogate evidence, establish trust and retain judgement and accountability.</p>
          <p>At the same time, AI is changing how I research and design. The boundary between designing and building is becoming more fluid, allowing questions to move from research, through design and into working software. For me, this is part of a familiar evolution in design tools. What matters is still the judgement about what to build, what not to build, and what needs to exist to answer the question.</p>
          <a class="b-inv learn" href="#work">Learn more →</a>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="section">
    <div class="wrap">
      <SectionHead>Cases</SectionHead>
      <RowList
        rows={caseRows(homeCases, 'year-read')}
        filters={caseFilters(homeCases)}
        headings={['Project', 'Category', 'Year · Read']}
        numbered={false}
        filterLabel="Filter work by category"
        fourthUpper
      />
      <a class="b-sec all-cases" href="/cases/">See all cases →</a>
    </div>
  </section>

  <section id="how" class="section">
    <div class="wrap">
      <SectionHead>How I work</SectionHead>
      <p class="lead how-lead">The question determines the method.</p>
      <p class="muted how-sub">I don’t begin with a particular design method. I begin by asking what we need to understand.</p>
      <div class="box-grid questions">
        {questions.map((q) => (
          <div class="q">
            <span class="q-n">{q.n}</span>
            <h3 class="q-title">{q.title}</h3>
            <p class="q-body">{q.body}</p>
            <p class="q-methods muted">{q.methods}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="design-research" class="section">
    <div class="wrap">
      <SectionHead>Design as research</SectionHead>
      <div class="split dr">
        <p class="lead dr-lead">Research doesn’t end with a report.</p>
        <p class="muted dr-body">Research can take many forms, and it doesn’t stop when designing or making begins. Mapping relationships, sketching an idea, staging an encounter or building working software can all be ways of investigating a question. What I make — and how I make it — depends on what I’m trying to understand.</p>
      </div>
      <div class="box-grid making">
        {making.map((m) => (
          <div class="m">
            {m.img
              ? <img class="m-img" src={m.img} alt="" loading="lazy" />
              : <div class="m-img thumb-placeholder">Image · {m.placeholder}</div>}
            <div class="m-text">
              <h3 class="m-title">{m.title}</h3>
              <p class="muted m-body">{m.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="research" class="section">
    <div class="wrap">
      <SectionHead>PhD in Design</SectionHead>
      <div class="split">
        <div class="phd-a">
          <p class="lead">A practice-based PhD in embodied and somatic design</p>
          <p class="muted phd-body">My research starts with people whose practices are deeply embodied. I work with practitioners from disciplines such as theatre and climbing to explore what their ways of working can teach us about design, and how thinking about design activities as encounters might change the way we understand embodied experience.</p>
        </div>
        <ul class="phd-list">
          {research.map((r) => (
            <li>
              <a class="l-row" href={r.href}>
                <span class="r-text">
                  <span class="r-title">{r.title}</span>
                  <span class="r-body">{r.body}</span>
                </span>
                <span class="r-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="wrap">
      <SectionHead>Get in touch</SectionHead>
      <a class="l-big" href="mailto:hello@scottrobinson.co.uk">hello@scottrobinson.co.uk</a>
      <div class="contact-actions">
        <a class="b-pri pk lg" href="mailto:hello@scottrobinson.co.uk">Get in touch →</a>
        <a class="b-sec lg" href="https://www.linkedin.com/in/drscottrobinson/">LinkedIn ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .split { display: flex; flex-wrap: wrap; gap: 32px 64px; margin-top: 40px; }

  /* In short */
  .split-main { flex: 2 1 480px; min-width: 0; }
  .intro { margin: 24px 0 0; max-width: 680px; }
  .cv { color: var(--ink); font-weight: 600; }
  .facts { flex: 1 1 300px; min-width: 0; grid-template-columns: minmax(0, 1fr); align-self: start; }
  .fact { padding: 20px 24px; }
  .fact-h {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .fact-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
  }

  /* Current focus */
  .focus { background: var(--accent); color: var(--on-accent); }
  .focus :global(a:focus-visible) { outline-color: var(--on-accent); }
  .focus-a { flex: 1 1 360px; min-width: 0; }
  .focus-b { flex: 1 1 420px; min-width: 0; }
  .focus-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(32px, 4vw, 60px);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  .focus-sub {
    margin: 24px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.25;
  }
  .focus-b p { margin: 0; }
  .focus-b p + p { margin-top: 16px; }
  .learn { margin-top: 28px; }

  /* Cases */
  .all-cases { min-height: 48px; padding: 0 20px; margin-top: 24px; }

  /* How I work */
  .how-lead { margin-top: 40px; }
  .how-sub { margin: 16px 0 0; max-width: 720px; font-size: 20px; }
  .questions { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 40px; }
  .q { padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .q-n { font-family: var(--font-mono); font-size: 13px; font-weight: 600; }
  .q-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .q-body { margin: 0; font-size: 16px; line-height: 1.55; }
  .q-methods {
    margin: auto 0 0;
    padding-top: 12px;
    border-top: var(--rule-thin) solid var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Design as research */
  .dr { gap: 16px 64px; }
  .dr-lead { flex: 1 1 320px; }
  .dr-body { flex: 1 1 420px; margin: 0; }
  .making { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-top: 40px; }
  .m { display: flex; flex-direction: column; }
  .m-img {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
    border-bottom: var(--rule) solid var(--ink);
  }
  .m-text { padding: 20px 24px 24px; }
  .m-title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.1;
  }
  .m-body { margin: 0; font-size: 15px; line-height: 1.55; }

  /* PhD in Design */
  .phd-a { flex: 1 1 420px; min-width: 0; }
  .phd-body { margin: 20px 0 0; }
  .phd-list {
    flex: 1 1 420px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule) solid var(--ink);
    align-self: start;
  }
  .phd-list li { border-bottom: var(--rule-thin) solid var(--ink); }
  .l-row {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    align-items: flex-start;
    padding-block: 20px;
    text-decoration: none;
    color: var(--ink);
  }
  .r-text { display: flex; flex-direction: column; gap: 6px; }
  .r-title { font-family: var(--font-display); font-weight: 800; font-size: 24px; line-height: 1.1; }
  .r-body { font-size: 15px; line-height: 1.5; color: var(--muted); }
  .r-arrow { font-family: var(--font-display); font-weight: 800; font-size: 28px; line-height: 1; }

  /* Get in touch */
  .l-big {
    display: block;
    margin-top: 40px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 5.4vw, 88px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration-thickness: 4px;
    text-underline-offset: 10px;
    overflow-wrap: anywhere;
  }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px; }
</style>
