---
import BaseLayout from '../layouts/BaseLayout.astro';
import RowList from '../components/RowList.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { caseRows, getCases } from '../lib/content';

// The homepage picks its cases and their order, leading with the AI work; the Cases page shows them all
const FEATURED = [
  'strategic-pivot-to-ai-research-platform',
  'designing-for-trust',
  'apex-mvp-backlog',
  'sustainable-fishing-ngo-mapping-digital-relationships',
  'auditing-student-digital-experience-in-a-russell-group-university',
  'musiciansfirst-connecting-musicians-fixers-and-bookers',
];
const allCases = await getCases();
const homeCases = FEATURED.map((id) => allCases.find((c) => c.id === id)).filter((c) => c !== undefined);

// How I work: four groups of methods, each with one of Scott's diagrams (light and dark versions)
const methods = [
  { title: 'Observing and interviewing', diagram: 2, body: 'Observing and interviewing people where the work happens, to see what is actually going on.', methods: 'Interviews · Observation · Contextual analysis · Data analysis' },
  { title: 'Workshops and mapping', diagram: 1, body: 'Bringing people together in workshops, so relationships between people, processes, data and services can be seen and questioned.', methods: 'Workshops · Stakeholder engagement · Relationship mapping · Experience mapping · Synthesis' },
  { title: 'Prototyping, lived or digital', diagram: 3, body: 'Giving an idea form, from a staged experience to working software, so it can be encountered before it is fully developed.', methods: 'Embodied ideation · Wizard of Oz · Concept development · Prototyping · AI-assisted prototyping' },
  { title: 'Testing and evaluation', diagram: 4, body: 'Putting ideas in front of people to learn what works, what doesn’t, and what we need to learn next.', methods: 'Usability testing · Remote testing · Prototype evaluation · Iteration · Product feedback · Market evidence' },
];

const research = [
  { title: 'Thesis', href: '/thesis/', body: 'I completed my AHRC-funded thesis at Goldsmiths, University of London, April 2026.' },
  { title: 'Publications', href: '/publications/', body: 'Read my research published by Bloomsbury, Taylor & Francis and Goldsmiths.' },
];

const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg>';
---
<BaseLayout
  title="Scott Robinson"
  description="I research encounters between people and technology, and use what I learn to design better products."
>
  <div class="g hero">
    <div class="fig-slot" aria-hidden="true"></div>
    <h1 class="statement">People don’t interact with technology. They <span class="hl">encounter it</span> as part of their <em>lived experience</em><svg class="glyph" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.2"></circle><path d="M9 0h2v6H9zM9 14h2v6H9zM0 9h6v2H0zM14 9h6v2h-6zM2.9 4.3l1.4-1.4 4.2 4.2-1.4 1.4zM11.5 12.9l1.4-1.4 4.2 4.2-1.4 1.4zM15.7 2.9l1.4 1.4-4.2 4.2-1.4-1.4zM7.1 11.5l1.4 1.4-4.2 4.2-1.4-1.4z"></path></svg></h1>
    <p class="lede">I’m Dr Scott Robinson. I research those encounters and use what I learn to design better products.</p>
  </div>

  <section class="g in-short" id="about">
    <h2 class="head statement">In short</h2>
    <p class="statement big">Designer, researcher and product strategist with <span class="hl">20+ years’ experience</span> and a practice-based PhD.</p>
    <p class="copy intro">I help organisations understand people and products, find where meaningful change is possible, and turn that into product vision, strategy and features. Most recently, I spent seven years at an AI fintech startup, where I led research, product strategy and UX for a research platform used by investment professionals in a heavily regulated industry.</p>
    <a class="slink after" href="/contact/"><span class="hl">CV available on request</span><Fragment set:html={arrow} /></a>
    <dl class="facts">
      <div><dt class="label">Specialisms</dt><dd>UX Research &amp; Design<br />Product Design and Strategy<br />Human–AI Decision-Making<br />Soma Design</dd></div>
      <div><dt class="label">Location</dt><dd>London, UK · Remote</dd></div>
    </dl>
  </section>

  <section class="g" id="work">
    <h2 class="head statement">Cases</h2>
    <p class="statement big">Currently focused on <span class="hl">human + AI decision-making</span></p>
    <p class="copy intro">My recent work explores how people work with increasingly capable AI and how they interrogate evidence, establish trust and retain judgement and accountability.</p>
    <RowList rows={caseRows(homeCases, 'client-year')} headings={['Project', 'Category', 'Client', 'Year']} />
    <a class="slink after" href="/cases/"><span class="hl">See all cases</span><Fragment set:html={arrow} /></a>
  </section>

  <section class="g" id="research">
    <h2 class="head statement">PhD in Design</h2>
    <p class="statement big">Encounters are my <span class="hl">contribution to design research</span></p>
    <p class="copy intro">Alongside my commercial work I collaborate with practitioners from disciplines such as theatre and climbing to explore what their ways of working can teach us about design. I write about how understanding design activities as encounters might change the way we understand embodied experience. I share what I learn through publications and conferences.</p>
    <div class="rows hov sub">
      {research.map((r) => (
        <a class="row sub" href={r.href}><span class="p-t"><span class="t">{r.title}</span></span><span class="p-b">{r.body}</span><span class="p-a" aria-hidden="true">→</span></a>
      ))}
    </div>
  </section>

  <section class="g" id="how">
    <h2 class="head statement">How I work</h2>
    <p class="statement big">Every design method is a chance for encounters to <span class="hl">generate knowledge</span>.</p>
    <p class="copy intro">I don’t begin with a particular design method. I begin by asking what we need to understand.</p>
    <div class="methods">
      {methods.map((m) => (
        <article class="mk method">
          <div class="img"><img class="lt" src={`/media/research-diagrams/diagram-${m.diagram}-light.png`} alt="" loading="lazy" /><img class="dk" src={`/media/research-diagrams/diagram-${m.diagram}-dark.png`} alt="" loading="lazy" /></div>
          <h3>{m.title}</h3>
          <p class="copy">{m.body}</p>
          <p class="m-list">{m.methods}</p>
        </article>
      ))}
    </div>
  </section>

  <ContactBlock />
</BaseLayout>

<style>
  /* Hero: the figure's slot, the heading, the line under it */
  .hero { padding-top: clamp(20px, 2.2vw, 40px); padding-bottom: clamp(80px, 9vw, 170px); }
  .fig-slot { grid-column: 1 / -1; height: var(--d-a); margin-bottom: clamp(20px, 2.4vw, 44px); }
  .hero h1 { grid-column: 1 / 10; margin: 0; font-size: clamp(42px, 5.6vw, 108px); line-height: 1.04; }
  .glyph { display: inline-block; width: .46em; height: .46em; margin-left: .1em; vertical-align: .04em; }
  .glyph * { fill: var(--ink); }
  .lede { grid-column: 1 / 6; margin-top: clamp(28px, 3vw, 48px); font-size: clamp(18px, 1.4vw, 24px); line-height: 1.4; font-weight: 500; letter-spacing: -.02em; }

  /* In short: statement left, facts on the right */
  .facts { grid-column: 9 / -1; grid-row: 2 / span 3; align-self: start; margin: clamp(16px, 1.4vw, 24px) 0 0; }
  .facts div { padding: 12px 0; border-top: 1px solid var(--ink); }
  .facts div:last-child { border-bottom: 1px solid var(--ink); }
  .facts dt { color: var(--grey); }
  .facts dd { margin: 4px 0 0; font-size: clamp(16px, 1.15vw, 19px); line-height: 1.4; letter-spacing: -.015em; }

  /* How I work: four cards that line up row by row (images, titles, lines and methods) */
  .methods { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gap); margin-top: clamp(40px, 4vw, 72px); }
  .method { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; padding-bottom: 40px; }
  .method > * { align-self: start; }
  .m-list { margin-top: 12px; font: 500 12px/1.55 var(--mono); letter-spacing: .01em; color: var(--grey); }

  @media (max-width: 1000px) { .methods { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .hero h1, .lede { grid-column: 1 / -1; }
    .fig-slot { margin-bottom: 20px; }
    .facts { grid-column: 1 / -1; grid-row: auto; }
    .methods { grid-template-columns: minmax(0, 1fr); }
    .method { padding-bottom: 32px; }
  }
</style>
